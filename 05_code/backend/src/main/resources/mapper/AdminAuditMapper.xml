<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.zhixing.mapper.AdminAuditMapper">
  <insert id="insertAudit">
    INSERT INTO admin_audit(id,admin_id,action_code,target_type,target_id,result_code,metadata_json,expires_at)
    VALUES(#{id},#{adminId},#{actionCode},#{targetType},#{targetId},#{resultCode},#{metadataJson},#{expiresAt})
  </insert>
</mapper>
