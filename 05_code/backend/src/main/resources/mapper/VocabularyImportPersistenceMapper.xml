<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.zhixing.mapper.VocabularyImportPersistenceMapper">
  <select id="listEnabledDatasets" resultType="map"><![CDATA[SELECT * FROM vocabulary_dataset_catalog WHERE enabled=1 ORDER BY updated_at DESC,created_at DESC]]></select>
  <insert id="insertUploadedDataset"><![CDATA[INSERT INTO vocabulary_dataset_catalog(id,dataset_code,dataset_name,provider_name,source_type,data_format,parser_code,version_label,license_status,license_note,checksum,item_count,source_payload,enabled) VALUES(#{p0},#{p1},#{p2},#{p3},'upload','json_or_csv','generic',#{p4}, #{p5},#{p6},#{p7.bytes,jdbcType=BINARY},#{p8}, #{p9},1)]]></insert>
  <select id="findDatasetForDeletion" resultType="map"><![CDATA[SELECT * FROM vocabulary_dataset_catalog WHERE id=#{p0}]]></select>
  <select id="lockDatasetForDeletion" resultType="map"><![CDATA[SELECT * FROM vocabulary_dataset_catalog WHERE id=#{p0} FOR UPDATE]]></select>
  <select id="countDatasetBatches" resultType="int"><![CDATA[SELECT COUNT(*) FROM vocabulary_import_batch WHERE dataset_id=#{p0}]]></select>
  <select id="countSnapshotWords" resultType="int"><![CDATA[SELECT COUNT(*) FROM vocabulary_online_word WHERE dataset_id=#{p0}]]></select>
  <delete id="deleteSnapshotWords"><![CDATA[DELETE FROM vocabulary_online_word WHERE dataset_id=#{p0}]]></delete>
  <update id="clearBooksSnapshot"><![CDATA[UPDATE vocabulary_online_book SET latest_dataset_id=NULL,actual_count=0,quality_summary=NULL,last_synced_at=NULL,updated_at=CURRENT_TIMESTAMP WHERE latest_dataset_id=#{p0}]]></update>
  <delete id="deleteDataset"><![CDATA[DELETE FROM vocabulary_dataset_catalog WHERE id=#{p0}]]></delete>
  <select id="findBatchForDeletion" resultType="map"><![CDATA[SELECT b.*,d.dataset_name FROM vocabulary_import_batch b JOIN vocabulary_dataset_catalog d ON d.id=b.dataset_id WHERE b.id=#{p0} FOR UPDATE]]></select>
  <select id="countPublishedItems" resultType="int"><![CDATA[SELECT COUNT(*) FROM vocabulary_import_item WHERE batch_id=#{p0}]]></select>
  <select id="countRunningAudioTasks" resultType="int"><![CDATA[SELECT COUNT(*) FROM tts_generation_task WHERE batch_id=#{p0}]]></select>
  <delete id="deleteBatchItems"><![CDATA[DELETE FROM vocabulary_import_item WHERE batch_id=#{p0}]]></delete>
  <delete id="deleteBatchAudioTasks"><![CDATA[DELETE FROM tts_generation_task WHERE batch_id=#{p0}]]></delete>
  <delete id="deleteBatch"><![CDATA[DELETE FROM vocabulary_import_batch WHERE id=#{p0}]]></delete>
  <select id="findDataset" resultType="map"><![CDATA[SELECT * FROM vocabulary_dataset_catalog WHERE id=#{p0} AND enabled=1]]></select>
  <select id="findTargetBook" resultType="map"><![CDATA[SELECT id FROM vocabulary_book WHERE id=#{p0} AND state='active']]></select>
  <insert id="insertBatch"><![CDATA[INSERT INTO vocabulary_import_batch(id,dataset_id,target_book_id,state,current_step,options_json,created_by) VALUES(#{p0},#{p1},#{p2},'draft','created',#{p3},#{p4})]]></insert>
  <select id="listRecentBatches" resultType="map"><![CDATA[SELECT b.*,d.dataset_name,d.license_status,book.book_name FROM vocabulary_import_batch b JOIN vocabulary_dataset_catalog d ON d.id=b.dataset_id JOIN vocabulary_book book ON book.id=b.target_book_id ORDER BY b.updated_at DESC,b.created_at DESC LIMIT 100]]></select>
  <select id="findBatchDetail" resultType="map"><![CDATA[SELECT b.*,d.dataset_name,d.license_status,book.book_name FROM vocabulary_import_batch b JOIN vocabulary_dataset_catalog d ON d.id=b.dataset_id JOIN vocabulary_book book ON book.id=b.target_book_id WHERE b.id=#{p0}]]></select>
  <select id="listBatchItems" resultType="map"><![CDATA[SELECT * FROM vocabulary_import_item WHERE batch_id=#{p0} ORDER BY row_no LIMIT 200]]></select>
  <select id="countSucceededAudioTasks" resultType="int"><![CDATA[SELECT COUNT(*) FROM tts_generation_task WHERE batch_id=#{p0} AND state IN ('pending','running')]]></select>
  <select id="countFailedAudioTasks" resultType="int"><![CDATA[SELECT COUNT(*) FROM tts_generation_task WHERE batch_id=#{p0} AND state='failed']]></select>
  <select id="lockBatchForParsing" resultType="map"><![CDATA[SELECT * FROM vocabulary_import_batch WHERE id=#{p0} FOR UPDATE]]></select>
  <select id="countPendingReviews" resultType="int"><![CDATA[SELECT COUNT(*) FROM vocabulary_import_item WHERE batch_id=#{p0} AND review_status='pending']]></select>
  <update id="updateBatchReviewState"><![CDATA[UPDATE vocabulary_import_batch SET state=#{p0},current_step=#{p1},updated_at=CURRENT_TIMESTAMP WHERE id=#{p2}]]></update>
  <update id="beginBatchParsing"><![CDATA[UPDATE vocabulary_import_batch SET state='running',current_step='parse',total_count=0,success_count=0,failed_count=0,reused_count=0,created_count=0,alias_count=0,skipped_count=0,review_count=0,last_error_code=NULL,last_error_message=NULL,started_at=CURRENT_TIMESTAMP,finished_at=NULL,updated_at=CURRENT_TIMESTAMP WHERE id=#{p0}]]></update>
  <select id="listSnapshotPayloads" resultType="string"><![CDATA[SELECT normalized_json FROM vocabulary_online_word WHERE dataset_id=#{p0} AND del_is=0 ORDER BY row_no]]></select>
  <select id="findWordIdsByHash" resultType="string"><![CDATA[SELECT id FROM learning_content WHERE content_type='word' AND word_key_hash=#{p0.bytes,jdbcType=BINARY} LIMIT 1]]></select>
  <insert id="insertBatchItem"><![CDATA[INSERT INTO vocabulary_import_item(id,batch_id,row_no,raw_json,word_term,normalized_word,word_key_hash,decision,content_id,review_status,risk_flags_json,error_code,error_message) VALUES(#{p0},#{p1},#{p2},#{p3},#{p4},#{p5},#{p6.bytes,jdbcType=BINARY},#{p7},#{p8},#{p9},#{p10},#{p11},#{p12})]]></insert>
  <update id="finishBatchParsing"><![CDATA[UPDATE vocabulary_import_batch SET state=#{p0},current_step=#{p1},total_count=#{p2},success_count=#{p3},failed_count=#{p4},reused_count=#{p5},created_count=#{p6},skipped_count=#{p7},review_count=#{p8},finished_at=CURRENT_TIMESTAMP,updated_at=CURRENT_TIMESTAMP WHERE id=#{p9}]]></update>
  <select id="findBatchItem" resultType="map"><![CDATA[SELECT * FROM vocabulary_import_item WHERE id=#{p0} AND batch_id=#{p1}]]></select>
  <update id="approveBatchItem"><![CDATA[UPDATE vocabulary_import_item SET decision='create',review_status='approved',error_code=NULL,error_message=NULL,updated_at=CURRENT_TIMESTAMP WHERE id=#{p0}]]></update>
  <update id="rejectBatchItem"><![CDATA[UPDATE vocabulary_import_item SET decision='skip',review_status='rejected',updated_at=CURRENT_TIMESTAMP WHERE id=#{p0}]]></update>
  <select id="countReviewDecisions" resultType="int"><![CDATA[SELECT COUNT(*) FROM vocabulary_import_item WHERE batch_id=#{p0} AND decision='review']]></select>
  <update id="markBatchReadyForReview"><![CDATA[UPDATE vocabulary_import_batch SET state='ready_for_review',current_step='tts_plan',review_count=0,updated_at=CURRENT_TIMESTAMP WHERE id=#{p0}]]></update>
  <update id="pauseBatch"><![CDATA[UPDATE vocabulary_import_batch SET state='paused',current_step='paused',updated_at=CURRENT_TIMESTAMP WHERE id=#{p0} AND state IN ('running','ready_for_review','review_required')]]></update>
  <select id="lockBatchWithSource" resultType="map"><![CDATA[SELECT b.*,d.source_url,d.license_note,d.license_status FROM vocabulary_import_batch b JOIN vocabulary_dataset_catalog d ON d.id=b.dataset_id WHERE b.id=#{p0} FOR UPDATE]]></select>
  <select id="listAudioTasksToRun" resultType="map"><![CDATA[SELECT t.*,i.raw_json,i.word_term FROM tts_generation_task t JOIN vocabulary_import_item i ON i.id=t.item_id WHERE t.batch_id=#{p0} AND t.state IN ('pending','failed') ORDER BY t.created_at,t.id LIMIT 10]]></select>
  <update id="startAudioTask"><![CDATA[UPDATE tts_generation_task SET state='running',attempt_count=attempt_count+1,error_code=NULL,error_message=NULL,updated_at=CURRENT_TIMESTAMP WHERE id=#{p0}]]></update>
  <update id="completeAudioTask"><![CDATA[UPDATE tts_generation_task SET state='succeeded',asset_id=#{p0},updated_at=CURRENT_TIMESTAMP WHERE id=#{p1}]]></update>
  <update id="failAudioTask"><![CDATA[UPDATE tts_generation_task SET state='failed',error_code=#{p0},error_message=#{p1},updated_at=CURRENT_TIMESTAMP WHERE id=#{p2}]]></update>
  <select id="countIncompleteAudioTasks" resultType="int"><![CDATA[SELECT COUNT(*) FROM tts_generation_task WHERE batch_id=#{p0} AND state<>'succeeded']]></select>
  <select id="lockBatchWithLicense" resultType="map"><![CDATA[SELECT b.*,d.license_status FROM vocabulary_import_batch b JOIN vocabulary_dataset_catalog d ON d.id=b.dataset_id WHERE b.id=#{p0} FOR UPDATE]]></select>
  <select id="countUnusableAudioTasks" resultType="int"><![CDATA[SELECT COUNT(*) FROM tts_generation_task WHERE batch_id=#{p0} AND (state<>'succeeded' OR asset_id IS NULL)]]></select>
  <update id="markBatchPublished"><![CDATA[UPDATE vocabulary_import_batch SET state='published',current_step='published',finished_at=CURRENT_TIMESTAMP,updated_at=CURRENT_TIMESTAMP WHERE id=#{p0}]]></update>
  <insert id="insertImportedSource"><![CDATA[INSERT INTO content_source(id,name,source_type,url,license_note,enabled) VALUES(#{p0},#{p1},#{p2},#{p3},#{p4},1)]]></insert>
  <select id="findBookLevel" resultType="map"><![CDATA[SELECT level_code FROM vocabulary_book WHERE id=#{p0}]]></select>
  <select id="findLastBookSort" resultType="int"><![CDATA[SELECT COALESCE(MAX(sort_no),0) FROM vocabulary_book_word WHERE book_id=#{p0}]]></select>
  <select id="listPublishableItems" resultType="map"><![CDATA[SELECT * FROM vocabulary_import_item WHERE batch_id=#{p0} AND decision IN ('create','reuse') AND review_status='approved' ORDER BY row_no]]></select>
  <select id="findWordByHash" resultType="map"><![CDATA[SELECT id FROM learning_content WHERE word_key_hash=#{p0.bytes,jdbcType=BINARY}]]></select>
  <insert id="insertPublishedWord"><![CDATA[INSERT INTO learning_content(id,content_type,source_id,dedup_hash,word_key_hash,stage,state,current_version_id,published_version_id,published_at) VALUES(#{p0},'word',#{p1},#{p2.bytes,jdbcType=BINARY},#{p3.bytes,jdbcType=BINARY},#{p4},'published',#{p5},#{p6},CURRENT_TIMESTAMP)]]></insert>
  <insert id="insertApprovedVersion"><![CDATA[INSERT INTO content_version(id,content_id,version_no,title,summary,difficulty,estimated_seconds,word_term,phonetic,meaning,example_text,example_translation,origin_url,license_snapshot,body_hash,review_status,created_by) VALUES(#{p0},#{p1},1,#{p2},#{p3},'intro',90,#{p4},#{p5},#{p6},#{p7},#{p8},#{p9},#{p10},#{p11.bytes,jdbcType=BINARY},'approved',#{p12})]]></insert>
  <insert id="insertWordSense"><![CDATA[INSERT INTO word_sense(id,content_version_id,part_of_speech,meaning,sort_no) VALUES(#{p0},#{p1},#{p2},#{p3},#{p4})]]></insert>
  <insert id="insertWordExample"><![CDATA[INSERT INTO word_example(id,sense_id,sentence,translation,sort_no) VALUES(#{p0},#{p1},#{p2},#{p3},#{p4})]]></insert>
  <select id="listCompletedItemAudioTasks" resultType="map"><![CDATA[SELECT * FROM tts_generation_task WHERE item_id=#{p0} AND state='succeeded']]></select>
  <insert id="insertPronunciation"><![CDATA[INSERT INTO pronunciation(id,content_version_id,sense_id,example_id,target_key,accent,phonetic,asset_id,state) VALUES(#{p0},#{p1},#{p2},#{p3},#{p4},#{p5},#{p6},#{p7},'ready')]]></insert>
  <update id="attachItemContent"><![CDATA[UPDATE vocabulary_import_item SET content_id=#{p0},updated_at=CURRENT_TIMESTAMP WHERE id=#{p1}]]></update>
  <insert id="insertBookWord"><![CDATA[INSERT INTO vocabulary_book_word(id,book_id,content_id,sort_no,importance,is_core,source_ref) VALUES(#{p0},#{p1},#{p2},#{p3},100,0,#{p4})]]></insert>
  <update id="refreshBookWordCount"><![CDATA[UPDATE vocabulary_book SET word_count=(SELECT COUNT(*) FROM vocabulary_book_word WHERE book_id=#{p0}),updated_at=CURRENT_TIMESTAMP WHERE id=#{p1}]]></update>
  <insert id="insertAudioTask"><![CDATA[INSERT INTO tts_generation_task(id,batch_id,item_id,target_type,sense_no,example_no,accent,provider_code,voice,object_key) VALUES(#{p0},#{p1},#{p2},#{p3},#{p4},#{p5},#{p6},'aliyun_nls',#{p7},#{p8})]]></insert>
  <update id="markBatchFailed"><![CDATA[UPDATE vocabulary_import_batch SET state='failed',current_step='failed',last_error_code=#{p0},last_error_message=#{p1},finished_at=CURRENT_TIMESTAMP,updated_at=CURRENT_TIMESTAMP WHERE id=#{p2}]]></update>
  <insert id="insertAudit"><![CDATA[INSERT INTO admin_audit(id,admin_id,action_code,target_type,target_id,result_code,metadata_json,expires_at) VALUES(#{p0},#{p1},#{p2},#{p3},#{p4},#{p5},#{p6},#{p7})]]></insert>
</mapper>
