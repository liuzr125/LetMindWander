.panel {
  margin-top: 48rpx;
  padding: 40rpx;
  overflow: hidden;
  background: #ffffff;
  border: 2rpx solid #e6eae5;
  border-radius: 28rpx;
  box-shadow: 0 16rpx 44rpx rgba(41, 62, 49, 0.06);
}

.mark {
  width: 56rpx;
  height: 8rpx;
  margin-bottom: 28rpx;
  background: #88a48f;
  border-radius: 999rpx;
}

.title,
.description {
  display: block;
}

.title {
  font-size: 34rpx;
  font-weight: 600;
}

.description {
  margin-top: 14rpx;
  color: #728077;
  font-size: 27rpx;
  line-height: 1.7;
}
