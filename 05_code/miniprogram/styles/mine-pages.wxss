page{background:linear-gradient(180deg,#f8fbff,#f2f6fd);color:#0b164e}.page{min-height:100vh;padding:28rpx 34rpx calc(60rpx + env(safe-area-inset-bottom));box-sizing:border-box}.card{margin-bottom:24rpx;padding:30rpx;border-radius:24rpx;background:rgba(255,255,255,.95);box-shadow:0 10rpx 32rpx rgba(40,77,126,.08)}.title{display:block;font-size:36rpx;font-weight:750}.subtitle,.muted{display:block;color:#687695;font-size:24rpx}.primary{margin:0;background:#0869f7;color:#fff;border-radius:16rpx}.primary::after,.secondary::after,.danger::after{border:0}.secondary{margin:0;color:#0869f7;background:#fff;border:2rpx solid #0869f7;border-radius:16rpx}.danger{margin:0;color:#e64242;background:#fff;border:2rpx solid #efb8b8;border-radius:16rpx}.state{padding:140rpx 30rpx;text-align:center;color:#71809a}.row{display:flex;align-items:center;justify-content:space-between}.avatar{width:104rpx;height:104rpx;border-radius:50%;background:#e6efff}.chip{display:inline-block;margin:10rpx 12rpx 0 0;padding:8rpx 18rpx;border-radius:10rpx;background:#edf4ff;color:#0870f7;font-size:22rpx}.tabs{display:flex;margin-bottom:24rpx;padding:8rpx;border-radius:18rpx;background:#fff}.tabs view{flex:1;padding:18rpx;text-align:center;color:#697592}.tabs .active{border-radius:13rpx;background:#0869f7;color:#fff}.input{box-sizing:border-box;width:100%;height:82rpx;padding:0 24rpx;border:1rpx solid #dce3ef;border-radius:16rpx;background:#fff}.error{display:block;margin:18rpx 0;color:#d8404d;font-size:23rpx}.badge-count{display:inline-flex;align-items:center;justify-content:center;min-width:38rpx;height:38rpx;padding:0 10rpx;border-radius:30rpx;background:#ef3333;color:#fff;font-size:21rpx}.arrow{color:#8490aa;font-size:34rpx}
