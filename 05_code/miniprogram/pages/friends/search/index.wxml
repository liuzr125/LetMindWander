<view class="page"><view class="card my-id"><image class="avatar" src="{{mine.avatarUrl||defaultAvatar}}"/><view><text class="muted">我的 ID</text><text class="id">{{mine.shortId}}</text></view><text class="copy" bindtap="copy">复制</text></view><text class="heading">搜索用户</text><view class="tabs"><view wx:for="{{types}}" wx:key="v" class="{{type===item.v?'active':''}}" data-v="{{item.v}}" bindtap="selectType">{{item.n}}</view></view><view class="search-row"><input class="input" placeholder="请输入查询内容" value="{{query}}" bindinput="input" bindconfirm="search"/><button class="primary" loading="{{loading}}" bindtap="search">搜索</button></view><view wx:if="{{results.length}}"><view wx:for="{{results}}" wx:key="id" class="card result {{selected.id===item.id?'selected':''}}" data-id="{{item.id}}" bindtap="choose"><image class="avatar" src="{{item.avatarUrl||defaultAvatar}}"/><view><text class="name">{{item.nickname}}</text><text class="muted">ID：{{item.shortId}}</text></view><text class="profile" data-id="{{item.id}}" catchtap="profile">查看资料 ›</text></view><view class="card"><text class="heading">申请备注 *</text><textarea maxlength="200" placeholder="让对方了解你是谁，以及添加的原因" value="{{remark}}" bindinput="remark"/></view><button class="primary send" loading="{{sending}}" bindtap="send">发送好友申请</button></view></view>
