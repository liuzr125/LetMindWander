@import "/styles/mine-pages.wxss";.top{text-align:right;margin-bottom:6rpx}.add{display:inline-block;width:auto;height:72rpx;line-height:72rpx;padding:0 34rpx;border-radius:36rpx;font-size:29rpx;font-weight:600;letter-spacing:1rpx;box-shadow:0 8rpx 20rpx rgba(8,105,247,.24)}.search{display:flex;align-items:center;gap:18rpx;height:86rpx;margin:24rpx 0;padding:0 24rpx;border-radius:18rpx;background:#fff}.search input{flex:1}.request-row{display:flex;align-items:center;gap:22rpx;font-size:29rpx}.request-row>text:nth-child(2){flex:1}.request-icon{color:#0869f7;font-size:40rpx}.section-title{display:block;margin:36rpx 0 22rpx;font-size:30rpx;font-weight:700}.friend{padding-bottom:0}.friend-head{display:flex;align-items:center;gap:22rpx;padding-bottom:24rpx}.friend-head>view{flex:1}.friend-name{display:block;font-size:29rpx;font-weight:700}.friend-name+.muted{margin-top:8rpx}.profile{color:#596581;font-size:23rpx}.shared{display:flex;justify-content:space-between;padding:24rpx 0;border-top:1rpx solid #e6ebf2;color:#51617e;font-size:24rpx}.tip{margin-top:34rpx;padding:28rpx;text-align:center;border:1rpx solid #cde0ff;border-radius:20rpx;background:#eef5ff;color:#0869f7;font-size:23rpx}
