<view class="page"><view class="top"><button class="primary add" bindtap="add">＋ 添加好友</button></view><view class="search"><text>⌕</text><input placeholder="搜索好友昵称或 ID" value="{{query}}" bindinput="input"/></view><view class="card request-row" bindtap="requests"><text class="request-icon">♧</text><text>好友申请</text><text wx:if="{{pending}}" class="badge-count">{{pending}}</text><text class="arrow">›</text></view><text class="section-title">我的好友 · {{filtered.length}} 位</text><view wx:if="{{loading}}" class="state">正在加载好友…</view><view wx:elif="{{error}}" class="state">{{error}}</view><view wx:elif="{{!filtered.length}}" class="state">还没有好友，先发送一条申请吧</view><view wx:else><view wx:for="{{filtered}}" wx:key="id" class="card friend"><view class="friend-head" data-id="{{item.id}}" bindtap="profile"><image class="avatar" src="{{item.avatarUrl||defaultAvatar}}"/><view><text class="friend-name">{{item.nickname}}</text><text class="muted">ID {{item.shortId}}</text></view><text class="profile">查看资料 ›</text></view><view class="shared" data-id="{{item.id}}" data-name="{{item.nickname}}" bindtap="shared"><text>▱ 共享知识 · {{item.sharedByMeCount+item.sharedByFriendCount}} 条</text><text class="arrow">›</text></view></view></view><view class="tip">点击头像查看资料，选择共享知识继续阅读</view></view>
