<view class="page"><view class="tabs"><view class="{{tab==='theirs'?'active':''}}" data-v="theirs" bindtap="tab">TA 共享的</view><view class="{{tab==='mine'?'active':''}}" data-v="mine" bindtap="tab">我共享的</view></view><view wx:if="{{loading}}" class="state">正在加载共享知识…</view><view wx:elif="{{!filtered.length}}" class="state">当前没有可见的共享知识</view><view wx:else><view wx:for="{{filtered}}" wx:key="id" class="card" data-id="{{item.id}}" bindtap="open"><view class="row"><text class="item-title">{{item.title}}</text><text class="arrow">›</text></view><text class="summary">{{item.summary}}</text></view></view></view>
