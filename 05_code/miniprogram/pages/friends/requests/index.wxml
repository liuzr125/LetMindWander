<view class="page"><view class="tabs"><view class="{{direction==='received'?'active':''}}" data-v="received" bindtap="tab">收到的</view><view class="{{direction==='sent'?'active':''}}" data-v="sent" bindtap="tab">发出的</view></view><view wx:if="{{loading}}" class="state">正在加载申请…</view><view wx:elif="{{!items.length}}" class="state">暂无好友申请</view><view wx:else><view wx:for="{{items}}" wx:key="id" class="card request"><view class="request-head"><image class="avatar" src="{{item.avatarUrl||defaultAvatar}}" data-id="{{item.userId}}" bindtap="profile"/><view><text class="name">{{item.nickname}}</text><text class="muted">ID {{item.shortId}}</text></view><text class="request-state {{item.state}}">{{item.state==='pending'?'待处理':item.state==='accepted'?'已添加':'已拒绝'}}</text></view><text class="remark">申请备注：{{item.remark}}</text><view wx:if="{{direction==='received'&&item.state==='pending'}}" class="actions"><button class="secondary" data-id="{{item.id}}" data-version="{{item.versionNo}}" data-decision="reject" bindtap="decide">拒绝</button><button class="primary" loading="{{busy===item.id}}" data-id="{{item.id}}" data-version="{{item.versionNo}}" data-decision="accept" bindtap="decide">同意</button></view></view></view></view>
