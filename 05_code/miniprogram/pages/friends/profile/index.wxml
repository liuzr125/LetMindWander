<view class="page"><view wx:if="{{loading}}" class="state">正在加载资料…</view><block wx:else><view class="card hero"><image class="avatar big" src="{{profile.avatarUrl||defaultAvatar}}"/><view><text class="name">{{profile.nickname}}</text><text class="muted">ID：{{profile.shortId}}</text><text class="friend-state">● {{profile.isFriend?'已经是好友':'公开资料'}}</text></view></view><view class="card"><text class="heading">资料</text><view wx:if="{{profile.fields.real_name}}" class="detail"><text>真实姓名</text><text>{{profile.fields.real_name}}</text></view><view wx:if="{{profile.fields.english_name}}" class="detail"><text>英语名字</text><text>{{profile.fields.english_name}}</text></view><view wx:if="{{profile.fields.birthday}}" class="detail"><text>生日</text><text>{{profile.fields.birthday}}</text></view><view wx:if="{{profile.fields.gender}}" class="detail"><text>性别</text><text>{{gender[profile.fields.gender]}}</text></view><text wx:if="{{!profile.fields.real_name&&!profile.fields.english_name&&!profile.fields.birthday&&!profile.fields.gender}}" class="muted">对方没有向你开放基础资料</text></view><view wx:if="{{profile.fields.hobbies}}" class="card"><text class="heading">爱好</text><text wx:for="{{profile.fields.hobbies}}" wx:key="*this" class="chip">{{item}}</text></view><view wx:if="{{profile.fields.introduction}}" class="card"><text class="heading">自我介绍</text><text class="intro">{{profile.fields.introduction}}</text></view><view wx:if="{{profile.isFriend}}" class="card shared" bindtap="shared"><view><text class="heading">共享知识</text><text class="muted">双方当前可见 {{shared.length}} 条 · 点击继续阅读</text></view><text class="arrow">›</text></view><button wx:if="{{profile.isFriend}}" class="danger remove" bindtap="remove">解除好友</button></block></view>
