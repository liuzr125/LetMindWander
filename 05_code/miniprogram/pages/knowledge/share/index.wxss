page{background:linear-gradient(180deg,#f8fbff,#f3f6fb);color:#08184c}.share-page{min-height:100vh;padding:30rpx 38rpx 70rpx}.state{padding:180rpx 20rpx;text-align:center;color:#71809a}.current-card,.visibility-card,.friends-card{padding:30rpx;border-radius:23rpx;background:rgba(255,255,255,.94);box-shadow:0 9rpx 28rpx rgba(31,60,102,.07)}.current-card{background:linear-gradient(145deg,#edf5ff,#fff)}.current-label{display:block;color:#1674f6;font-size:23rpx}.current-title{display:block;margin-top:18rpx;font-size:30rpx;font-weight:650}.visibility-card{margin-top:28rpx}.option{display:flex;align-items:flex-start;gap:22rpx;padding:27rpx 0;border-bottom:1rpx solid #e3e8f0}.option:first-child{padding-top:4rpx}.option:last-child{padding-bottom:4rpx;border:0}.radio{width:38rpx;height:38rpx;margin-top:3rpx;border:3rpx solid #b8c1d1;border-radius:50%}.radio.selected{border:10rpx solid #1475f7;background:#dcecff}.option-title{display:block;font-size:28rpx}.option-copy{display:block;margin-top:8rpx;color:#7a869d;font-size:22rpx}.friends-card{margin-top:24rpx}.friends-head{display:flex;justify-content:space-between;font-size:27rpx;font-weight:650}.count{color:#1475f7;font-size:23rpx;font-weight:400}.search{display:flex;align-items:center;gap:15rpx;height:76rpx;margin-top:24rpx;padding:0 20rpx;border:1rpx solid #dbe2ec;border-radius:14rpx}.search input{flex:1;font-size:24rpx}.friend-row{display:flex;align-items:center;gap:18rpx;padding:22rpx 0;border-bottom:1rpx solid #e6eaf0;font-size:26rpx}.friend-row image,.avatar{width:58rpx;height:58rpx;border-radius:50%}.avatar{display:flex;align-items:center;justify-content:center;color:#fff;background:linear-gradient(145deg,#4a8ff7,#735ddb)}.empty{padding:45rpx 10rpx;color:#7b879b;text-align:center;font-size:23rpx}.safety{display:block;margin-top:24rpx;padding:17rpx;border-radius:12rpx;color:#687896;background:#f1f6ff;font-size:21rpx}.save-hint{display:block;margin-top:32rpx;color:#7a869d;text-align:center;font-size:22rpx}.confirm{margin-top:25rpx;color:#fff;background:#1475f7;font-size:28rpx}.confirm::after{border:0}
