<view class="knowledge-page">
  <view class="page-head">
    <text class="page-title">知识库</text>
    <button class="add-button" bindtap="createKnowledge" aria-label="新建知识">＋</button>
  </view>
  <view class="search-box">
    <text class="search-icon">⌕</text>
    <input value="{{query}}" bindinput="onQueryInput" confirm-type="search" placeholder="搜索标题、正文、标签" />
    <text wx:if="{{query}}" class="clear" bindtap="clearQuery">×</text>
  </view>
  <scroll-view class="type-tabs" scroll-x enhanced show-scrollbar="{{false}}">
    <view class="type-row">
      <button wx:for="{{tabs}}" wx:key="key" class="tab {{type === item.key ? 'active' : ''}}" data-key="{{item.key}}" bindtap="selectType">{{item.label}}</button>
      <button class="tab filter {{showFilters || learningStatus || verificationStatus ? 'active-outline' : ''}}" bindtap="toggleFilters">⌄ 筛选</button>
    </view>
  </scroll-view>
  <view wx:if="{{showFilters}}" class="filter-panel">
    <text class="filter-title">学习状态</text>
    <view class="filter-options"><text wx:for="{{learningOptions}}" wx:key="key" class="filter-chip {{learningStatus === item.key ? 'selected' : ''}}" data-key="{{item.key}}" bindtap="selectLearning">{{item.label}}</text></view>
    <text class="filter-title second">验证状态</text>
    <view class="filter-options"><text wx:for="{{verificationOptions}}" wx:key="key" class="filter-chip {{verificationStatus === item.key ? 'selected' : ''}}" data-key="{{item.key}}" bindtap="selectVerification">{{item.label}}</text></view>
    <text class="reset" bindtap="resetFilters">重置筛选</text>
  </view>
  <view wx:if="{{loading}}" class="state-text">正在整理你的知识…</view>
  <view wx:elif="{{error}}" class="state-text error"><text>{{error}}</text><button bindtap="load">重试</button></view>
  <view wx:elif="{{!items.length}}" class="empty-state">
    <view class="empty-illustration"><text>⌕</text></view>
    <text class="empty-title">没找到相关记录</text>
    <text class="empty-copy">{{query || learningStatus || verificationStatus ? '换个关键词或筛选条件试试。' : '从一条笔记开始，留下今天的理解。'}}</text>
    <button class="empty-action" bindtap="createKnowledge">新建笔记</button>
  </view>
  <view wx:else class="knowledge-list">
    <view wx:for="{{items}}" wx:key="id" class="knowledge-card" data-id="{{item.id}}" bindtap="openItem">
      <view class="card-main">
        <view class="type-icon type-{{item.itemType}}">{{item.icon}}</view>
        <view class="card-copy">
          <text class="card-title">{{item.title}}</text>
          <view class="meta-line"><text>{{item.typeName}}</text><text class="status {{item.statusTone}}">● {{item.statusName}}</text></view>
        </view>
        <text class="more" catchtap="openMenu" data-id="{{item.id}}">•••</text>
      </view>
      <text wx:if="{{item.summary}}" class="summary">{{item.summary}}</text>
      <view class="tags"><text wx:for="{{item.tags}}" wx:for-item="tag" wx:key="*this">{{tag}}</text></view>
      <view class="card-foot"><text>{{item.updatedLabel}}</text><text>▢ {{item.visibilityName}}</text></view>
    </view>
  </view>
</view>
