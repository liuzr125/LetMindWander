page{background:linear-gradient(180deg,#f8fbff,#f4f6fa);color:#08184c}.detail-page{min-height:100vh;padding:35rpx 36rpx 190rpx}.state{padding:180rpx 20rpx;text-align:center;color:#6d7890}.state text{display:block}.state button{width:180rpx;margin-top:24rpx}.title-row{display:flex;align-items:flex-start;gap:16rpx}.title{flex:1;font-size:43rpx;font-weight:730;line-height:1.35}.draft{margin-top:10rpx;padding:6rpx 13rpx;border-radius:10rpx;color:#d47d18;background:#fff3dd;font-size:21rpx}.status-row{display:flex;gap:14rpx;margin-top:22rpx}.status-row text{padding:8rpx 16rpx;border-radius:10rpx;font-size:23rpx}.learning{color:#1471f5;background:#eef5ff}.verification{color:#e38312;background:#fff5e5}.source-card,.problem-card,.note-card,.note-entry,.review-row{margin-top:28rpx;padding:28rpx;border:1rpx solid #d9e4f4;border-radius:22rpx;background:rgba(255,255,255,.92);box-shadow:0 8rpx 24rpx rgba(34,65,105,.05)}.source-card{background:linear-gradient(145deg,#f2f7ff,#fff)}.source-label{display:block;color:#1673f5;font-size:23rpx}.source-title{display:block;margin-top:20rpx;font-size:30rpx;font-weight:650}.source-summary{display:-webkit-box;overflow:hidden;margin-top:14rpx;color:#62708c;font-size:24rpx;line-height:1.55;-webkit-box-orient:vertical;-webkit-line-clamp:3}.source-link{display:block;margin-top:18rpx;color:#0b70f5;font-size:23rpx}.section-label,.section-title{display:block;font-size:27rpx;font-weight:680}.problem-row{display:flex;flex-direction:column;gap:12rpx;padding:24rpx 0;border-bottom:1rpx solid #e4e9f1;color:#42516f;font-size:26rpx;line-height:1.55}.problem-row:last-child{border-bottom:0}.field-label{color:#0b194d;font-weight:650}.body{display:block;margin-top:22rpx;color:#273858;font-size:27rpx;line-height:1.8;white-space:pre-wrap}.tag-section{margin-top:28rpx}.tags{display:flex;flex-wrap:wrap;gap:14rpx;margin-top:16rpx}.tags text{padding:9rpx 19rpx;border:1rpx solid #dce3ed;border-radius:11rpx;color:#52607b;background:#fff;font-size:23rpx}.note-entry,.review-row{display:flex;align-items:center;justify-content:space-between}.muted{display:block;margin-top:10rpx;color:#78849a;font-size:23rpx}.vis-readonly{margin-top:24rpx;display:flex;align-items:center;justify-content:space-between;padding:28rpx;border:1rpx solid #d9e4f4;border-radius:22rpx;background:rgba(255,255,255,.92);box-shadow:0 8rpx 24rpx rgba(34,65,105,.05)}.vis-value{color:#66748f;font-size:26rpx}.bottom-actions{position:fixed;z-index:10;left:0;right:0;bottom:0;display:flex;gap:14rpx;padding:22rpx 34rpx calc(22rpx + env(safe-area-inset-bottom));background:rgba(255,255,255,.97);border-top:1rpx solid #e3e8f0}.bottom-actions button{flex:1;height:78rpx;margin:0;padding:0;line-height:78rpx;color:#17305f;background:#fff;font-size:24rpx}.bottom-actions button::after{border:1rpx solid #dce3ec;border-radius:14rpx}
