page{background:linear-gradient(180deg,#f8fbff 0,#f3f6fb 100%);color:#08184c}.knowledge-page{min-height:100vh;padding:32rpx 30rpx 210rpx}.page-head{display:flex;flex-direction:column;align-items:flex-start}.page-title{font-size:50rpx;font-weight:760;letter-spacing:1rpx}.page-slogan{margin-top:10rpx;color:#77839b;font-size:24rpx;letter-spacing:2rpx}.fab{position:fixed;right:40rpx;bottom:calc(56rpx + env(safe-area-inset-bottom));z-index:20;display:flex;align-items:center;justify-content:center;box-sizing:border-box;width:96rpx;height:96rpx;min-width:96rpx;max-width:96rpx;min-height:96rpx;margin:0;padding:0;border:0;border-radius:50%;overflow:hidden;color:#fff;background:linear-gradient(145deg,#3b8cff,#1674f6);font-size:44rpx;font-weight:300;line-height:96rpx;text-align:center;box-shadow:0 12rpx 26rpx rgba(22,116,246,.35)}.fab::after{border:0}.fab:active{transform:scale(.94)}.search-box{display:flex;align-items:center;height:86rpx;margin-top:28rpx;padding:0 24rpx;border:2rpx solid #dfe5ef;border-radius:18rpx;background:rgba(255,255,255,.86)}.search-icon{margin-right:16rpx;color:#77829b;font-size:39rpx}.search-box input{flex:1;font-size:27rpx}.clear{padding:10rpx;color:#65728e;font-size:36rpx}.type-tabs{margin-top:26rpx;white-space:nowrap}.type-row{display:flex;gap:16rpx;padding-bottom:4rpx}.tab{flex:none;height:68rpx;margin:0;padding:0 26rpx;line-height:66rpx;border-radius:14rpx;color:#526078;background:#fff;font-size:25rpx}.tab::after{border:1rpx solid #dce2eb;border-radius:14rpx}.tab.active{color:#fff;background:#1674f6;box-shadow:0 8rpx 18rpx rgba(24,116,246,.22)}.tab.active::after{border:0}.tab.active-outline{color:#086df1;background:#eef5ff}.filter-panel{margin-top:18rpx;padding:26rpx;border-radius:20rpx;background:#fff;box-shadow:0 10rpx 28rpx rgba(35,63,104,.08)}.filter-title{display:block;font-size:25rpx;font-weight:650}.filter-title.second{margin-top:24rpx}.filter-options{display:flex;flex-wrap:wrap;gap:12rpx;margin-top:14rpx}.filter-chip{padding:10rpx 17rpx;border:1rpx solid #dbe2ed;border-radius:12rpx;color:#66728c;font-size:23rpx}.filter-chip.selected{border-color:#1674f6;color:#086df1;background:#eef5ff}.reset{display:block;margin-top:24rpx;color:#1674f6;text-align:right;font-size:24rpx}.knowledge-list{display:flex;flex-direction:column;gap:22rpx;margin-top:26rpx}.knowledge-card{padding:27rpx 27rpx 22rpx;border:1rpx solid #dce3ee;border-radius:20rpx;background:rgba(255,255,255,.92);box-shadow:0 9rpx 22rpx rgba(28,58,97,.05)}.card-main{display:flex;align-items:flex-start}.type-icon{display:flex;align-items:center;justify-content:center;width:58rpx;height:58rpx;border-radius:12rpx;color:#fff;background:linear-gradient(145deg,#25aa78,#168c6d);font-size:25rpx;font-weight:650}.type-problem{background:linear-gradient(145deg,#ff9e2e,#ff7e21)}.type-word{background:linear-gradient(145deg,#2397ff,#1363e9)}.card-copy{flex:1;min-width:0;margin-left:19rpx}.card-title{display:block;overflow:hidden;color:#071a50;font-size:29rpx;font-weight:680;line-height:1.35;text-overflow:ellipsis;white-space:nowrap}.meta-line{display:flex;align-items:center;gap:15rpx;margin-top:8rpx;color:#6a7690;font-size:23rpx}.status{font-size:22rpx}.status.primary{color:#176ef0}.status.warning{color:#ec8a19}.status.success{color:#15915d}.more{padding:4rpx 0 14rpx 18rpx;color:#53617a;font-weight:700;letter-spacing:2rpx}.summary{display:-webkit-box;overflow:hidden;margin-top:20rpx;color:#66738e;font-size:24rpx;line-height:1.55;-webkit-box-orient:vertical;-webkit-line-clamp:2}.tags{display:flex;flex-wrap:wrap;gap:10rpx;margin-top:18rpx}.tags text{padding:6rpx 14rpx;border-radius:9rpx;color:#52627e;background:#f1f4f9;font-size:21rpx}.card-foot{display:flex;justify-content:space-between;margin-top:23rpx;color:#77839a;font-size:21rpx}.state-text,.empty-state{padding:150rpx 20rpx;text-align:center;color:#6c7892}.state-text text{display:block}.state-text button{width:190rpx;margin-top:24rpx}.empty-state{display:flex;align-items:center;flex-direction:column;padding-top:125rpx}.empty-illustration{display:flex;align-items:center;justify-content:center;width:160rpx;height:160rpx;border:12rpx solid #dce8fb;border-radius:36rpx;color:#1674f6;background:#f9fbff;font-size:78rpx;transform:rotate(-3deg)}.empty-title{margin-top:45rpx;color:#071a50;font-size:37rpx;font-weight:700}.empty-copy{margin-top:18rpx;font-size:26rpx}.empty-action{width:100%;margin-top:52rpx;color:#0b6ff1;background:#fff;border:2rpx solid #1674f6}.empty-action::after{border:0}
