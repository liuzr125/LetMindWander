page{background:linear-gradient(180deg,#f8fbff,#f3f6fb);color:#08184c}.editor-page{min-height:100vh;padding:28rpx 36rpx 190rpx}.state{padding:160rpx;text-align:center;color:#71809b}.lead{display:block;color:#1674f6;font-size:25rpx}.form-card,.source-card,.share-card{margin-top:28rpx;padding:30rpx;border-radius:23rpx;background:rgba(255,255,255,.94);box-shadow:0 9rpx 28rpx rgba(31,60,102,.07)}.source-card{border:1rpx solid #d4e3fb;background:linear-gradient(145deg,#f0f6ff,#fff)}.source-label{display:block;color:#1674f6;font-size:23rpx}.source-title{display:block;margin-top:18rpx;font-size:29rpx;font-weight:650}.source-summary{display:-webkit-box;overflow:hidden;margin-top:12rpx;color:#64728d;font-size:23rpx;line-height:1.55;-webkit-box-orient:vertical;-webkit-line-clamp:3}.label{font-size:26rpx;font-weight:680}.gap{display:block;margin-top:34rpx}.required{color:#ef3f32}.type-picker{display:flex;gap:20rpx;margin-top:18rpx}.type-option{display:flex;align-items:center;justify-content:center;flex:1;height:82rpx;border:2rpx solid #dbe2ed;border-radius:14rpx;color:#5a6680;font-size:27rpx}.type-option.selected{border-color:#1475f7;color:#1470ed;background:#f4f8ff}.input,.textarea,.small-area{width:100%;margin-top:15rpx;padding:21rpx;border:1rpx solid #dbe1eb;border-radius:14rpx;background:#fff;font-size:26rpx}.textarea{box-sizing:border-box;min-height:260rpx;line-height:1.7}.label-row{display:flex;align-items:flex-end;justify-content:space-between}.count{color:#8a94a8;font-size:20rpx}.problem-hint{display:block;margin-top:28rpx;color:#758099;font-size:22rpx}.small-label{display:block;margin-top:24rpx;font-size:24rpx;font-weight:620}.small-area{box-sizing:border-box;min-height:108rpx;line-height:1.5}.small-area.large{min-height:160rpx}.tags,.suggestions{display:flex;flex-wrap:wrap;gap:12rpx;margin-top:17rpx}.tags text{padding:10rpx 17rpx;border-radius:10rpx;color:#126df1;background:#eaf3ff;font-size:23rpx}.tag-input{display:flex;gap:14rpx;margin-top:16rpx}.tag-input input{flex:1;padding:18rpx 20rpx;border:1rpx solid #dbe2ec;border-radius:13rpx;background:#fff;font-size:24rpx}.tag-input button{width:120rpx;margin:0;padding:0;line-height:72rpx;color:#fff;background:#1674f6;font-size:24rpx}.tag-input button::after{border:0}.hint{display:block;margin-top:13rpx;color:#7b879e;font-size:21rpx}.suggestions text{padding:8rpx 15rpx;border:1rpx solid #e0e5ed;border-radius:10rpx;color:#59677f;background:#f7f8fb;font-size:21rpx}.share-card{display:flex;align-items:center;justify-content:space-between}.share-title{display:block;font-size:26rpx;font-weight:650}.bottom-actions{position:fixed;z-index:10;left:0;right:0;bottom:0;display:flex;gap:20rpx;padding:23rpx 38rpx calc(23rpx + env(safe-area-inset-bottom));background:rgba(255,255,255,.97);border-top:1rpx solid #e3e8f0}.bottom-actions button{flex:1;margin:0;color:#126ef0;background:#fff}.bottom-actions button::after{border:2rpx solid #1475f7;border-radius:14rpx}.bottom-actions .primary{color:#fff;background:#1475f7}
