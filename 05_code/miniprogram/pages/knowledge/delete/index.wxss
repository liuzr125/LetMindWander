page{background:linear-gradient(180deg,#f8fbff,#f3f6fb);color:#08184c}.delete-page{min-height:100vh;padding:80rpx 38rpx}.state{text-align:center;color:#748099}.dialog{display:flex;align-items:center;flex-direction:column;padding:45rpx 34rpx;border-radius:26rpx;background:#fff;box-shadow:0 14rpx 44rpx rgba(30,57,95,.12)}.danger-icon{display:flex;align-items:center;justify-content:center;width:94rpx;height:94rpx;border-radius:50%;color:#fff;background:#e5483d;font-size:56rpx;font-weight:700}.title{margin-top:30rpx;font-size:34rpx;font-weight:700}.name{margin-top:18rpx;color:#344362;font-size:27rpx;font-weight:600;text-align:center}.warning{margin-top:25rpx;color:#68748d;font-size:24rpx;line-height:1.7;text-align:center}.impacts{display:flex;align-self:stretch;flex-direction:column;gap:15rpx;margin-top:28rpx;padding:24rpx;border-radius:16rpx;color:#6e4b4b;background:#fff5f4;font-size:22rpx}.actions{display:flex;align-self:stretch;gap:18rpx;margin-top:36rpx}.actions button{flex:1;margin:0;font-size:25rpx}.actions .danger{color:#fff;background:#e5483d}.actions .danger::after{border:0}
