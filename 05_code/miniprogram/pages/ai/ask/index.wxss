page{background:#f7f9ff;color:#0b164e}.ask-page{min-height:100vh;padding:36rpx 38rpx 80rpx}.hero{padding:8rpx 4rpx 28rpx}.eyebrow,.title,.subtitle{display:block}.eyebrow{color:#0869f7;font-size:23rpx;font-weight:650}.title{margin-top:12rpx;font-size:50rpx;font-weight:800}.subtitle{margin-top:12rpx;color:#6d7892;font-size:25rpx;line-height:1.65}.state,.compose-card,.answer-card,.history-card,.empty{border:1rpx solid #e0e7f2;border-radius:22rpx;background:#fff;box-shadow:0 8rpx 26rpx rgba(32,64,120,.05)}.state,.empty{padding:60rpx 26rpx;text-align:center;color:#74809a}.state text{display:block}.state button{width:210rpx;margin-top:24rpx;color:#0869f7;background:#fff}.compose-card{padding:28rpx}.model-row{display:flex;align-items:center;justify-content:space-between;padding-bottom:24rpx;border-bottom:1rpx solid #edf0f5}.label,.model-status{display:block}.label{font-size:27rpx;font-weight:700}.model-status{margin-top:6rpx;color:#75819a;font-size:21rpx}.model-name{max-width:340rpx;padding:15rpx 20rpx;border-radius:13rpx;color:#0869f7;background:#edf5ff;font-size:23rpx;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.compose-card textarea{width:100%;height:240rpx;margin-top:24rpx;font-size:29rpx;line-height:1.65}.compose-foot{display:flex;align-items:center;justify-content:space-between;color:#8a94a7;font-size:21rpx}.compose-foot button{width:180rpx;height:70rpx;margin:0;line-height:70rpx;border:0;border-radius:14rpx;color:#fff;background:#0869f7;font-size:27rpx}.compose-foot button[disabled]{background:#aab8ce}.compose-foot button::after{border:0}.consent{display:block;margin:20rpx 4rpx;color:#66738e;font-size:22rpx;line-height:1.55}.consent label{display:flex;align-items:flex-start}.consent checkbox{margin-right:8rpx}.answer-card{margin-top:28rpx;padding:30rpx;border-color:#bfd8ff;background:linear-gradient(145deg,#fff,#f2f7ff)}.answer-head,.history-meta,.history-head{display:flex;align-items:center;justify-content:space-between}.answer-head text:first-child,.