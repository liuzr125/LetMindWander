.page{padding:32rpx;background:#f6f7f9;min-height:100vh;box-sizing:border-box}.heading{font-size:40rpx;font-weight:600;margin-bottom:12rpx}.subtitle,.date{color:#7a8594;font-size:24rpx}.card{background:white;padding:30rpx;border-radius:24rpx;margin-top:24rpx}.title{font-size:32rpx;font-weight:600;word-break:break-all;margin-bottom:16rpx}.empty{padding:60rpx 0;text-align:center;color:#7a8594}.body{white-space:pre-wrap;word-break:break-word;font-size:30rpx;line-height:1.8;margin-top:32rpx}