<view class="page"><view class="heading">最新公告</view><view class="subtitle">了解最近的升级与变化</view><view wx:for="{{items}}" wx:key="id" class="card" data-id="{{item.id}}" bindtap="open"><view class="title">{{item.title}}</view><view class="date">{{item.date}}　›</view></view><view wx:if="{{loading}}" class="empty">加载中…</view><view wx:if="{{error}}" class="empty" bindtap="retry">{{error}} · 点击重试</view><view wx:if="{{!loading && !error && !items.length}}" class="empty">暂时没有公告</view></view>