page {
  background: #f6f9f6;
  color: #243e30;
}
.page {
  padding: 40rpx 32rpx;
}
.eyebrow {
  font-size: 20rpx;
  letter-spacing: 4rpx;
  color: #7f9c8a;
}
.title {
  font-size: 48rpx;
  font-weight: 700;
  margin: 14rpx 0;
}
.subtitle {
  font-size: 25rpx;
  color: #88968e;
  line-height: 1.7;
}
.tabs {
  display: flex;
  gap: 40rpx;
  margin: 40rpx 0 26rpx;
  font-size: 29rpx;
  color: #95a197;
}
.tabs view {
  padding-bottom: 14rpx;
}
.tabs .selected {
  color: #315c45;
  font-weight: 700;
  border-bottom: 5rpx solid #315c45;
}
.search {
  display: flex;
  align-items: center;
  background: white;
  border-radius: 16rpx;
  padding: 10rpx 16rpx;
  margin-bottom: 28rpx;
}
.search input {
  flex: 1;
  font-size: 27rpx;
}
.search button {
  background: #edf4ee;
  color: #315c45;
}
.card {
  display: flex;
  gap: 30rpx;
  background: white;
  border: 1rpx solid #e4ece5;
  border-radius: 22rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
}
.cover {
  width: 160rpx;
  min-width: 160rpx;
  height: 230rpx;
  box-sizing: border-box;
  padding: 22rpx;
  background: linear-gradient(145deg, #315c45, #91af9b);
  color: white;
  border-radius: 5rpx 14rpx 14rpx 5rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  font-size: 18rpx;
  letter-spacing: 3rpx;
}
.cover-title {
  font-size: 26rpx;
  font-weight: 700;
  letter-spacing: 0;
  max-height: 170rpx;
  overflow: hidden;
}
.info {
  flex: 1;
  min-width: 0;
}
.badge {
  font-size: 19rpx;
  color: #7f9c87;
}
.name {
  font-size: 31rpx;
  font-weight: 700;
  margin: 12rpx 0;
  line-height: 1.4;
}
.author {
  color: #98a199;
  font-size: 22rpx;
}
.progress {
  font-size: 23rpx;
  color: #82948a;
  margin: 18rpx 0;
}
.continue {
  color: #315c45;
  font-size: 25rpx;
}
.state {
  text-align: center;
  padding: 45rpx 20rpx;
  color: #8a978e;
  font-size: 27rpx;
  line-height: 1.8;
}

.difficulty {
  margin: 20rpx 0;
  font-size: 25rpx;
  color: #65816b;
}

.cover {
  position: relative;
  overflow: hidden;
}
.cover image {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  opacity: 0.55;
}
.cover text {
  position: relative;
  z-index: 1;
}
