page { background:#f5f9ff; color:#101448; }
.profile-page { min-height:100vh; background:#f5f9ff; }
.navigation { background:#f5f9ff; }
.navigation-content { display:flex; align-items:center; font-size:34rpx; color:#080b15; font-weight:500; }
.back { width:94rpx; padding-left:42rpx; font-size:56rpx; line-height:1; color:#0e164d; }
.page-content { padding:18rpx 42rpx 16rpx; padding-bottom:calc(16rpx + env(safe-area-inset-bottom)); }
.section { background:#fff; border-radius:24rpx; padding:0 32rpx; margin-bottom:16rpx; box-shadow:0 6rpx 26rpx rgba(92,135,193,.035); }
.avatar-row { display:flex; align-items:center; padding:28rpx 32rpx; min-height:182rpx; gap:28rpx; }
.avatar { width:124rpx; height:124rpx; border-radius:50%; flex-shrink:0; background:#eaf2ff; }
.avatar-meta { min-width:0; flex:1; }
.row-label { font-size:28rpx; flex-shrink:0; }
.muted { color:#8085ad; }
.id { display:block; font-size:23rpx; margin-top:20rpx; overflow-wrap:anywhere; }
.row-action { color:#0067ff; font-size:24rpx; white-space:nowrap; }
.default-avatar { position:relative; overflow:hidden; }
.person-head { position:absolute; width:40rpx; height:40rpx; top:28rpx; left:42rpx; border-radius:50%; background:#0067ff; }
.person-body { position:absolute; width:66rpx; height:30rpx; top:76rpx; left:29rpx; border-radius:40rpx 40rpx 0 0; background:#0067ff; }
.phone-row { display:flex; justify-content:space-between; align-items:center; min-height:132rpx; gap:10rpx; }
.phone-note { display:block; font-size:20rpx; margin-top:12rpx; }
.readonly-cell { display:flex; align-items:center; gap:18rpx; }
.phone-number { font-size:24rpx; white-space:nowrap; }
.readonly { display:flex; align-items:center; gap:8rpx; font-size:20rpx; white-space:nowrap; }
.lock-icon { display:inline-block; width:14rpx; height:15rpx; border:2rpx solid #8085ad; border-radius:2rpx; position:relative; }
.lock-icon::before { content:''; position:absolute; width:7rpx; height:7rpx; border:2rpx solid #8085ad; border-bottom:0; border-radius:6rpx 6rpx 0 0; top:-8rpx; left:1.5rpx; }
.basic-section { padding-top:6rpx; }
.field-row { display:flex; align-items:center; justify-content:space-between; gap:18rpx; min-height:81rpx; border-bottom:1rpx solid #edf0f6; font-size:28rpx; }
.field-row.last { border-bottom:0; }
.nickname-row { padding:8rpx 0 18rpx; border-bottom:1rpx solid #edf0f6; }
.nickname-row .field-row { min-height:60rpx; border:0; }
.nickname-note { display:block; font-size:18rpx; margin-top:4rpx; }
.required { color:#ed242e; }
.text-input { flex:1; min-width:0; text-align:right; font-size:28rpx; height:64rpx; color:#101448; }
.calendar-icon { font-size:35rpx; color:#0067ff; }
.clear-date { color:#8085ad; font-size:22rpx; padding:12rpx; }
.chevron { color:#8085ad; font-size:32rpx; }
.hobby-section { padding-top:26rpx; padding-bottom:22rpx; }
.hobby-list { display:flex; flex-wrap:wrap; gap:18rpx; margin:20rpx 0; }
.hobby-tag { display:flex; align-items:center; gap:12rpx; color:#0067ff; background:#f0f6ff; border:1rpx solid #d7e6ff; border-radius:10rpx; padding:8rpx 16rpx; font-size:24rpx; }
.hobby-remove { padding:0 2rpx; }
.hobby-entry { display:flex; gap:16rpx; }
.hobby-input { flex:1; min-width:0; height:64rpx; border:1rpx solid #dce0ed; border-radius:12rpx; padding:0 20rpx; font-size:23rpx; }
button::after { border:0; }
.hobby-add { margin:0; padding:0; width:120rpx; height:64rpx; line-height:64rpx; font-size:24rpx; color:#0067ff; background:#f0f6ff; border:1rpx solid #d7e6ff; border-radius:12rpx; }
.intro-section { padding-top:26rpx; padding-bottom:22rpx; }
.intro-box { position:relative; margin-top:20rpx; border:1rpx solid #dce0ed; border-radius:12rpx; padding:14rpx 14rpx 38rpx; }
.intro-textarea { width:100%; height:62rpx; min-height:62rpx; font-size:23rpx; line-height:1.6; color:#101448; }
.intro-count { position:absolute; right:38rpx; bottom:12rpx; font-size:18rpx; color:#8085ad; }
.visibility-row { display:flex; justify-content:space-between; align-items:center; min-height:72rpx; font-size:26rpx; }
.save-button { margin:22rpx 0 0; height:82rpx; line-height:82rpx; background:#0067ff; color:#fff; font-size:30rpx; border-radius:14rpx; font-weight:400; }
.save-button[disabled] { background:#c8dcfb; color:#fff; }
.error-message { display:block; color:#ce3546; margin:16rpx 0; font-size:24rpx; }
.hint { display:block; text-align:center; color:#8085ad; font-size:23rpx; padding:12rpx; }
.overlay { position:fixed; z-index:100; top:0; right:0; bottom:0; left:0; display:flex; align-items:flex-end; background:rgba(20,30,49,.68); }
.sheet { width:100%; background:#fff; border-radius:64rpx 64rpx 0 0; padding:30rpx 34rpx 42rpx; padding-bottom:calc(42rpx + env(safe-area-inset-bottom)); max-height:85vh; overflow-y:auto; }
.sheet-title { display:block; text-align:center; color:#101010; font-size:30rpx; padding:6rpx 0 34rpx; }
.sheet-item { display:flex; align-items:center; gap:42rpx; height:122rpx; border-bottom:1rpx solid #e9e9ec; color:#111; padding:0 22rpx; font-size:27rpx; }
.sheet-icon { width:44rpx; height:38rpx; display:flex; align-items:center; justify-content:center; border:3rpx solid #111; border-radius:6rpx; font-size:38rpx; line-height:1; position:relative; }
.camera-icon::before { content:''; position:absolute; width:18rpx; height:6rpx; top:-9rpx; left:9rpx; border:3rpx solid #111; border-bottom:0; border-radius:4rpx 4rpx 0 0; }
.sheet-person { width:44rpx; height:44rpx; position:relative; }
.sheet-person::before { content:''; position:absolute; top:0; left:12rpx; width:18rpx; height:18rpx; border:3rpx solid #111; border-radius:50%; }
.sheet-person::after { content:''; position:absolute; bottom:0; left:4rpx; width:34rpx; height:17rpx; border:3rpx solid #111; border-radius:24rpx 24rpx 3rpx 3rpx; }
.cancel-button { background:#f6f7fa; border-radius:20rpx; margin:26rpx 0 0; height:94rpx; line-height:94rpx; color:#111; font-size:28rpx; font-weight:400; }
.candidate { margin:0 auto 22rpx; display:block; }
@media (max-width:350px) { .page-content { padding-left:24rpx; padding-right:24rpx; } .phone-number { font-size:22rpx; } .readonly-cell { gap:12rpx; } }
