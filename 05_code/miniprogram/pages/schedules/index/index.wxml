<view class="page"><view class="banner"><view><text class="title">今天的新发现，替你整理好了</text><text class="subtitle">按你设定的节奏，收集值得看的内容。</text></view><text class="book">▱</text></view><view class="summary"><view><text class="number">{{items.length}}</text><text>个任务</text></view></view><view class="tabs"><view wx:for="{{tabs}}" wx:key="v" class="{{state===item.v?'active':''}}" data-v="{{item.v}}" bindtap="tab">{{item.n}}</view></view><view wx:if="{{loading}}" class="state">正在加载任务…</view><view wx:elif="{{error}}" class="state">{{error}}</view><view wx:elif="{{!items.length}}" class="state">还没有定时任务</view><view wx:else><view wx:for="{{items}}" wx:key="id" class="card schedule"><view class="schedule-head"><view><text class="name">{{item.name}}</text><text wx:for="{{item.topics}}" wx:key="*this" class="chip">{{item}}</text><text class="muted">◷ {{item.dayText}} {{item.timeText}} · 北京时间</text></view><switch checked="{{item.state==='active'}}" color="#0869f7" data-id="{{item.id}}" bindchange="toggle"/></view><view class="run"><text>{{item.lastRunState?('最近运行：'+item.lastRunState):'尚未运行'}}</text><text wx:if="{{item.lastResultCount}}">新增 {{item.lastResultCount}} 条</text></view><button class="secondary edit" data-id="{{item.id}}" bindtap="edit">编辑</button></view></view><button class="primary create" bindtap="create">＋ 新建定时任务</button><text class="foot">仅整理公开来源，保留原文入口。</text></view>
