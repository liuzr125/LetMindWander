<view class="page"><view wx:if="{{loading}}" class="state">正在加载配置…</view><block wx:else><view class="card hero"><text class="title">想发现什么？</text><text class="subtitle">选好主题，剩下的按时整理。</text></view><view class="card field"><text>任务名称 *</text><input maxlength="20" placeholder="例如：每日技术资源" value="{{form.name}}" data-key="name" bindinput="input"/></view><view class="card"><text class="heading">关注内容 *</text><view><text wx:for="{{topics}}" wx:key="*this" class="topic {{selectedTopics[item]?'selected':''}}" data-v="{{item}}" bindtap="topic">{{item}}</text></view></view><view class="card field"><text>关键词</text><input maxlength="500" placeholder="RAG、开发工具、学习方法" value="{{form.keywords}}" data-key="keywords" bindinput="input"/></view><view class="card"><text class="heading">来源范围 *</text><view wx:for="{{sources}}" wx:key="id" class="source" data-v="{{item.id}}" bindtap="source"><text>{{item.name}}</text><text>{{selectedSources[item.id]?'✓':'○'}}</text></view></view><view class="card"><text class="heading">执行计划 *</text><view class="tabs"><view class="{{frequency==='daily'?'active':''}}" data-v="daily" bindtap="frequency">每天</view><view class="{{frequency==='workday'?'active':''}}" data-v="workday" bindtap="frequency">工作日</view><view class="{{frequency==='weekly'?'active':''}}" data-v="weekly" bindtap="frequency">每周</view></view><view class="config-row"><text>执行时间</text><picker mode="time" value="{{time}}" bindchange="onTime"><text>{{time}}　北京时间</text></picker></view><view class="config-row"><text>每次收集上限</text><view class="stepper"><text data-d="-1" bindtap="step">−</text><text>{{form.perRunLimit}} 条</text><text data-d="1" bindtap="step">＋</text></view></view></view><view class="card"><view class="config-row"><text>自动过滤重复内容</text><switch checked="{{form.dedupEnabled}}" data-key="dedupEnabled" bindchange="toggle" color="#0869f7"/></view><view class="config-row"><view><text>生成简短摘要</text><text class="subtitle">只整理要点，保留来源。</text></view><switch checked="{{form.summaryEnabled}}" data-key="summaryEnabled" bindchange="toggle" color="#0869f7"/></view></view><button class="primary save" data-state="active" loading="{{saving}}" bindtap="save">保存并启用</button><button class="pause" data-state="paused" bindtap="save">也可先保存为暂停</button></block></view>
