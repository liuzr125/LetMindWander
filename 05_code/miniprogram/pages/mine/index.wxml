<view class="mine-page"><view wx:if="{{loading}}" class="state">正在加载…</view><block wx:else>
 <view class="user-card" bindtap="goProfile"><image class="avatar" src="{{profile.avatarUrl||defaultAvatar}}" mode="aspectFill"/><view class="identity"><text class="nickname">{{profile.nickname||'学习者'}}</text><text class="trial">受邀试用</text></view><text class="profile-link">个人资料 ›</text></view>
 <view class="plan-card" bindtap="goPlan"><text class="plan-icon">▣</text><view class="plan-copy"><text class="plan-title">{{planText}}</text><text class="plan-meta">{{planMeta}}</text></view><text class="plan-link">调整计划 ›</text></view>
 <view class="menu-card"><view class="menu-item" bindtap="goPlan"><text class="icon">▤</text><text>我的计划</text><text class="arrow">›</text></view><view class="menu-item" bindtap="goHistory"><text class="icon">◷</text><text>复盘历史</text><text class="arrow">›</text></view><view class="menu-item" bindtap="goFavorites"><text class="icon">☆</text><text>我的收藏</text><text class="arrow">›</text></view><view class="menu-item" bindtap="goFriends"><text class="icon">♧</text><text>好友与共享</text><text wx:if="{{overview.pendingFriendRequests}}" class="badge-count">{{overview.pendingFriendRequests}}</text><text class="arrow">›</text></view><view class="menu-item" bindtap="goBookProgress"><text class="icon">Aa</text><text>词书学习进度</text><text class="arrow">›</text></view><view class="menu-item" bindtap="goWordbook"><text class="icon">▱</text><text>生词本</text><text class="arrow">›</text></view><view class="menu-item" bindtap="goSchedules"><text class="icon">⌁</text><text>定时任务</text><text wx:if="{{overview.activeSchedules}}" class="menu-note">{{overview.activeSchedules}} 个运行中</text><text class="arrow">›</text></view><view class="menu-item" bindtap="goPrivacy"><text class="icon">◇</text><text>隐私与数据</text><text class="arrow">›</text></view><view class="menu-item last" bindtap="goFeedback"><text class="icon">◌</text><text>问题反馈</text><text class="arrow">›</text></view></view>
 <view class="usage-card" bindtap="goUsage"><text class="usage-title">AI 用量</text><view class="usage-row"><text class="spark">✦</text><view><text class="muted">今日已用</text><text class="usage-value">{{overview.aiUsed||0}} / {{overview.aiLimit||10}} 次</text></view><text class="usage-note">由你主动使用 ›</text></view></view>
 <text wx:if="{{error}}" class="error">{{error}}</text><text class="timezone">时间按北京时间</text></block></view>
