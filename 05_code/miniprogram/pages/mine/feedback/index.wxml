<view class="page"><view class="card"><text class="title">告诉我们哪里可以更好</text><text class="subtitle">默认不附带你的私人正文。</text><view class="category"><view wx:for="{{categories}}" wx:key="v" class="{{category===item.v?'selected':''}}" data-v="{{item.v}}" bindtap="select">{{item.n}}</view></view></view><view class="card"><textarea maxlength="2000" placeholder="请描述问题或建议" value="{{body}}" bindinput="input"/><text class="counter">{{count}} / 2000</text></view><view class="card"><input class="input" placeholder="错误请求 ID（选填）" value="{{requestId}}" bindinput="request"/></view><button class="primary submit" loading="{{sending}}" bindtap="submit">提交反馈</button></view>
