<view class="page"><view class="search"><text>⌕</text><input placeholder="搜索收藏标题" value="{{query}}" bindinput="input" bindconfirm="search"/><text bindtap="search">搜索</text></view><view class="tabs"><view wx:for="{{tabs}}" wx:key="v" class="{{type===item.v?'active':''}}" data-v="{{item.v}}" bindtap="select">{{item.n}}</view></view><view wx:if="{{loading}}" class="state">正在加载收藏…</view><view wx:elif="{{error}}" class="state">{{error}}</view><view wx:elif="{{!items.length}}" class="state">还没有符合条件的收藏</view><view wx:else><view wx:for="{{items}}" wx:key="targetId" class="card favorite" data-id="{{item.targetId}}" data-type="{{item.targetType}}" bindtap="open"><view class="row"><text class="item-title">{{item.title}}</text><text class="star">★</text></view><text class="summary">{{item.summary||'点击继续阅读'}}</text><text class="time">收藏于 {{item.favoritedAt}}</text></view></view></view>
