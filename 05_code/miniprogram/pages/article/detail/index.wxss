page{background:#f6f9ff;color:#09164c}.article-page{min-height:100vh;padding:34rpx 40rpx 180rpx}.state{padding:130rpx 20rpx;text-align:center;color:#6b7894}.state button{width:180rpx;margin-top:24rpx}
.title,.summary,.source{display:block}.title{font-size:53rpx;font-weight:800;line-height:1.25}.summary{margin-top:20rpx;color:#334463;font-size:31rpx}.meta{display:flex;flex-wrap:wrap;gap:12rpx;margin-top:26rpx}.meta text{padding:7rpx 16rpx;border-radius:10rpx;color:#0869f7;background:#eaf2ff;font-size:23rpx}.source{margin-top:24rpx;color:#71809d;font-size:24rpx}
.title-translation{display:block;margin-top:20rpx;color:#334463;font-size:31rpx;line-height:1.5}.title-translation.pending{color:#71809d}.title-translation-retry{margin:20rpx 0 0;padding:0;text-align:left;color:#0869f7;background:transparent;font-size:29rpx}.title-translation-retry::after{border:0}
.translation-switch{display:flex;align-items:center;justify-content:space-between;margin-top:30rpx;padding:24rpx 30rpx;border-radius:22rpx;background:#fff;box-shadow:0 8rpx 26rpx rgba(31,67,126,.06);font-size:29rpx;font-weight:650}.paragraph-card{margin-top:24rpx;padding:34rpx;border-radius:24rpx;background:#fff;box-shadow:0 8rpx 28rpx rgba(31,67,126,.07)}.english,.translation{display:block;font-size:31rpx;line-height:1.75}.translation{margin-top:18rpx;color:#566685;font-size:27rpx}.explain{margin-top:24rpx;color:#0869f7;background:#f8fbff;border:2rpx solid #cfe0fb;font-size:25rpx}.explain::after{border:0}
.audio-card{margin-top:28rpx;padding:28rpx;border:1rpx solid #d8e6fb;border-radius:24rpx;background:linear-gradient(145deg,#fff,#f1f6ff);box-shadow:0 8rpx 28rpx rgba(31,67,126,.07)}.audio-head,.follow-row,.speed-row,.word-top,.word-actions{display:flex;align-items:center;justify-content:space-between}.audio-title,.audio-note{display:block}.audio-title{font-size:28rpx;font-weight:750}.audio-note{margin-top:7rpx;color:#70809b;font-size:21rpx}.audio-head button,.follow-row button{min-width:170rpx;margin:0;padding:0 20rpx;color:#fff;background:#0869f7;font-size:24rpx}.audio-head button::after,.follow-row button::after,.record-play::after,.word-actions button::after{border:0}.speed-row{justify-content:flex-start;gap:12rpx;margin-top:24rpx;color:#6d7991;font-size:23rpx}.speed{padding:10rpx 18rpx;border:1rpx solid #d4ddeb;border-radius:10rpx;background:#fff}.speed.active{border-color:#0869f7;color:#0869f7;background:#eaf3ff}.follow-row{margin-top:26rpx;padding-top:24rpx;border-top:1rpx solid #dce5f2}.follow-row .outline{color:#0869f7;background:#fff;border:1rpx solid #9fc6fb}.follow-row .recording{background:#e34d59}.record-play{margin-top:20rpx;color:#0869f7;background:#fff;border:1rpx solid #bad5fb;font-size:24rpx}.inline-word{padding:2rpx 1rpx;border-radius:5rpx}.inline-word.known{color:#075fd8;border-bottom:2rpx dotted #72a7ec}.word-mask{position:fixed;z-index:40;inset:0;display:flex;align-items:flex-end;background:rgba(5,15,45,.35)}.word-sheet{box-sizing:border-box;width:100%;padding:34rpx 38rpx calc(40rpx + env(safe-area-inset-bottom));border-radius:30rpx 30rpx 0 0;background:#fff}.selected-term,.selected-phonetic,.selected-meaning{display:block}.selected-term{font-size:44rpx;font-weight:800}.selected-phonetic{margin-top:8rpx;color:#6e7b94;font-size:26rpx}.selected-meaning{margin-top:28rpx;font-size:29rpx;line-height:1.6}.close{padding:10rpx;color:#6d7890;font-size:42rpx}.word-actions{gap:18rpx;margin-top:30rpx}.word-actions button{flex:1;color:#0869f7;background:#eef5ff}.word-actions button[disabled]{color:#8994a8;background:#eef1f5}
.bottom-actions{position:fixed;z-index:20;left:0;right:0;bottom:0;display:flex;gap:12rpx;padding:24rpx 28rpx calc(24rpx + env(safe-area-inset-bottom));background:rgba(255,255,255,.97);border-top:1rpx solid #e3e8f0}.bottom-actions button{flex:1;margin:0;padding:0;height:78rpx;line-height:78rpx;color:#334d78;background:#fff;border:1rpx solid #dce4ef;font-size:24rpx}.bottom-actions .primary{color:#fff;background:#0869f7;border-color:#0869f7}.bottom-actions button::after{border:0}
.record-actions{display:flex;gap:14rpx;margin-top:20rpx}.record-actions button{flex:1;margin:0;font-size:24rpx}.record-actions .record-play{margin-top:0}.record-delete{color:#d63e4a;background:#fff;border:1rpx solid #f0c6ca}.record-delete::after{border:0}
.translation-missing{margin-top:18rpx;color:#0869f7;background:#f5f9ff;border:1rpx solid #cfe0fb;font-size:24rpx}.explanation-mask{position:fixed;z-index:50;inset:0;display:flex;align-items:flex-end;background:rgba(5,15,45,.4)}.explanation-sheet{box-sizing:border-box;width:100%;padding:34rpx 38rpx calc(40rpx + env(safe-area-inset-bottom));border-radius:30rpx 30rpx 0 0;background:#fff}.explanation-scroll{max-height:55vh;margin-top:22rpx;color:#263852;font-size:29rpx;line-height:1.65;white-space:pre-wrap}
.word-source{display:block;margin-top:10rpx;color:#8b7045;font-size:21rpx}.word-lookup-error{display:flex;align-items:center;justify-content:space-between;gap:14rpx;margin-top:14rpx;color:#b53d4b;font-size:22rpx}.word-lookup-error button{margin:0;white-space:nowrap;color:#0869f7;background:#eef5ff;font-size:22rpx}
