<view class="history-page"><text class="title">复盘历史</text><text class="subtitle">回看真实记录，不改写当时的完成快照。</text><view wx:if="{{loading}}" class="state">正在加载…</view><view wx:elif="{{error}}" class="state">{{error}}</view><view wx:elif="{{!items.length}}" class="state">还没有复盘记录</view><view wx:else class="list"><view wx:for="{{items}}" wx:key="journalId" class="item" bindtap="open" data-date="{{item.businessDate}}"><view><text class="date">{{item.businessDate}}</text><text class="summary">{{item.doneText || item.learnedText || '已保存复盘草稿'}}</text></view><view><text class="status">{{item.state === 'submitted' ? '已提交' : '草稿'}}</text><text class="arrow">›</text></view></view></view></view>
