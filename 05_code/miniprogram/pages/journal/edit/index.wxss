page{background:linear-gradient(180deg,#fffaf0,#f8fbff 38%);color:#0b164e}.journal-page{padding:30rpx 30rpx 70rpx}.loading{padding-top:160rpx;text-align:center;color:#6f7890}.date{display:block;font-size:28rpx;font-weight:650}.intro{display:flex;align-items:center;gap:22rpx;margin:36rpx 0 18rpx}.intro-icon{display:flex;align-items:center;justify-content:center;width:82rpx;height:82rpx;border:2rpx solid #f5b34d;border-radius:18rpx;color:#ff920a;font-size:42rpx}.intro-title,.intro-copy{display:block}.intro-title{font-size:35rpx;font-weight:750}.intro-copy{margin-top:8rpx;color:#6a758f}.save-state{display:block;margin-bottom:24rpx;color:#667393;font-size:23rpx}.question{position:relative;margin-top:18rpx;padding:24rpx 24rpx 48rpx;border:1rpx solid #dfe5ef;border-radius:18rpx;background:#fff;box-shadow:0 8rpx 24rpx rgba(30,64,120,.04)}.label{display:block;font-weight:700}.question textarea{width:100%;height:120rpx;margin-top:14rpx;font-size:27rpx;line-height:1.6}.count{position:absolute;right:20rpx;bottom:16rpx;color:#7e879e;font-size:21rpx}.ai-row{display:flex;gap:12rpx;margin-top:26rpx}.ai-row button{flex:1;margin:0;padding:0;height:70rpx;line-height:70rpx;color:#0869f7;background:#fff;border:1rpx solid #cbdaf3;font-size:23rpx}.ai-row button::after,.submit::after{border:0}.submit{height:84rpx;margin-top:22rpx;line-height:84rpx;color:#fff;background:#0869f7;border-radius:14rpx;font-size:29rpx}
