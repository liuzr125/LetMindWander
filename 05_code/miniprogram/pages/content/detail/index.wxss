page{background:#f8faff;color:#0b164e}.detail-page{min-height:100vh;padding:34rpx 42rpx 170rpx}.state{padding:120rpx 20rpx;text-align:center;color:#667392}.state button{width:180rpx;margin-top:24rpx}.title{display:block;font-size:45rpx;font-weight:750;line-height:1.35}.tags{display:flex;gap:12rpx;flex-wrap:wrap;margin-top:20rpx}.tags text{padding:7rpx 18rpx;border-radius:10rpx;color:#0869f7;background:#eaf2ff;font-size:23rpx}.summary{display:block;margin-top:28rpx;color:#4e5d7f;font-size:27rpx}.source{display:flex;gap:18rpx;margin-top:18rpx;color:#697592;font-size:24rpx}.source-link{color:#0869f7}.divider{height:1rpx;margin:34rpx 0;background:#e2e7f0}.body{white-space:pre-wrap;font-size:29rpx;line-height:1.85}.principle{display:flex;gap:16rpx;margin-top:34rpx;padding:28rpx;border:2rpx solid #dbe6fa;border-radius:18rpx;background:#fff;color:#344465;line-height:1.65}.quote{color:#4388ef;font-size:52rpx;line-height:1}.ai{margin-top:30rpx;color:#0869f7;background:#f8fbff;border:2rpx solid #cfe0fb}.license{display:block;margin-top:24rpx;color:#8993aa;font-size:22rpx}.bottom-actions{position:fixed;z-index:20;left:0;right:0;bottom:0;display:flex;gap:12rpx;padding:24rpx 28rpx calc(24rpx + env(safe-area-inset-bottom));background:rgba(255,255,255,.96);border-top:1rpx solid #e3e8f0}.bottom-actions button{flex:1;margin:0;padding:0;height:78rpx;line-height:78rpx;color:#33517f;background:#fff;border:1rpx solid #dce4ef;font-size:24rpx}.bottom-actions .primary{color:#fff;background:#0869f7;border-color:#0869f7}.bottom-actions button::after,.ai::after{border:0}
