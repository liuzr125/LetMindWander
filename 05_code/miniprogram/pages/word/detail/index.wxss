page{background:#f6f9ff;color:#0a174f}.word-page{padding:34rpx 40rpx 245rpx}.state{padding:120rpx 20rpx;text-align:center;color:#687694}
.word{display:block;margin-top:18rpx;font-size:82rpx;font-weight:800;letter-spacing:2rpx}.pronounce{margin-top:26rpx}.phonetic{display:block;color:#566582;font-size:32rpx;font-weight:500}.play-row{display:flex;align-items:center;justify-content:center;gap:26rpx;margin-top:24rpx}.play-btn{display:flex;align-items:center;gap:12rpx;margin:0;padding:0 32rpx;height:68rpx;line-height:1;border-radius:999rpx;color:#0d7a66;background:#eaf8f4;border:1rpx solid #d2eee4;font-size:26rpx;font-weight:600}.play-btn:active{transform:scale(.96)}.play-btn::after{border:0}.play-icon{display:inline-block;width:30rpx;height:30rpx;background:url("data:image/svg+xml,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20viewBox%3D%220%200%2024%2024%22%20fill%3D%22none%22%20stroke%3D%22%230d7a66%22%20stroke-width%3D%222.2%22%20stroke-linecap%3D%22round%22%20stroke-linejoin%3D%22round%22%3E%3Cpath%20d%3D%22M11%205%206%209H2v6h4l5%204V5z%22%2F%3E%3Cpath%20d%3D%22M15.54%208.46a5%205%200%200%201%200%207.07%22%2F%3E%3C%2Fsvg%3E") no-repeat center/contain}
.translation{display:block;margin-top:24rpx;font-size:38rpx}.tags{display:flex;gap:16rpx;margin-top:20rpx}.tags text{padding:10rpx 24rpx;border:2rpx solid #cbdcff;border-radius:14rpx;color:#0869f7}
.card,.familiarity{margin-top:26rpx;padding:30rpx;border:1rpx solid #e1e7f0;border-radius:24rpx;background:#fff;box-shadow:0 8rpx 28rpx rgba(33,74,135,.06)}.card-title{display:block;margin-bottom:18rpx;font-size:31rpx;font-weight:750}.sense-block+.sense-block{margin-top:22rpx;padding-top:22rpx;border-top:1rpx solid #e8ebf1}.sense{display:flex;gap:18rpx;margin-top:15rpx;font-size:29rpx;line-height:1.6}.pos{align-self:flex-start;padding:3rpx 12rpx;border-radius:8rpx;color:#5a3ed0;background:#ece9ff}.meaning,.sentence,.example-translation{display:block;font-size:29rpx;line-height:1.7}.sense-example{display:flex;align-items:center;gap:16rpx;margin-top:18rpx;color:#24365c}.sense-example-copy{flex:1;min-width:0}.example-translation{margin-top:8rpx;color:#53617e}.source text:last-child,.action view text:last-child{color:#65718e}.action{display:flex;justify-content:space-between;align-items:center}
.example-card-content{display:flex;align-items:center;gap:22rpx}.example-copy{flex:1;min-width:0}.example-play{display:flex;align-items:center;justify-content:center;box-sizing:border-box;flex:0 0 64rpx;width:64rpx;height:64rpx;border-radius:50%;color:#087b69;background:#ebf8f5;font-size:28rpx}.example-play-pressed{background:#d8f1eb;transform:scale(.94)}
.familiarity{font-size:28rpx}.familiarity-head{display:flex;justify-content:space-between}.percent{color:#0869f7;font-weight:700}.familiarity slider{margin:18rpx 0 0}
.bottom-actions{position:fixed;z-index:10;left:0;right:0;bottom:0;display:flex;flex-wrap:wrap;gap:12rpx;padding:22rpx 34rpx calc(22rpx + env(safe-area-inset-bottom));background:#fff;border-top:1rpx solid #e1e7f0}.bottom-actions button{flex:1;margin:0;height:76rpx;padding:0;line-height:76rpx;color:#0869f7;background:#fff;border:2rpx solid #0869f7;font-size:24rpx}.bottom-actions .primary{color:#fff;background:#0869f7}.bottom-actions .review{flex-basis:100%}.bottom-actions button::after{border:0}.bottom-actions button[disabled]{color:#9fabc0!important;background:#eef2f8!important;border-color:#dfe5f0!important}
.memory-title{display:flex;align-items:flex-start;justify-content:space-between}.memory-title .card-title{margin-bottom:6rpx}.memory-title>text{color:#0869f7;font-size:24rpx}.memory-caption,.memory-note,.memory-empty{display:block;color:#687694;font-size:23rpx;line-height:1.6}.memory-hint{margin-top:20rpx;padding:22rpx;border-radius:18rpx;background:#f5f8ff;line-height:1.65}.memory-meta{display:flex;gap:12rpx;margin-bottom:10rpx}.memory-meta text{padding:4rpx 10rpx;border-radius:8rpx;color:#315c45;background:#e8f5ee;font-size:21rpx}.memory-start{margin-top:24rpx;color:#fff;background:#315c45}.memory-start::after{border:0}.memory-note{margin-top:14rpx}
