page{background:#f5f8ff;color:#13234d}.page{padding:32rpx}.state{padding:140rpx 20rpx;text-align:center;color:#687694}.progress{display:flex;justify-content:space-between;color:#687694;font-size:24rpx}.card{margin-top:24rpx;padding:34rpx;border-radius:28rpx;background:#fff;box-shadow:0 12rpx 34rpx rgba(30,62,118,.08)}.dimension{padding:7rpx 16rpx;border-radius:10rpx;color:#315c45;background:#eaf5ef;font-size:23rpx}.word{display:block;margin-top:34rpx;text-align:center;font-size:70rpx;font-weight:800}.meaning{display:block;margin-top:34rpx;text-align:center;font-size:38rpx;font-weight:700}.prompt{display:block;margin-top:26rpx;text-align:center;color:#53617c;font-size:28rpx}.answer{box-sizing:border-box;margin-top:28rpx;width:100%;padding:24rpx;border:2rpx solid #cfd9e8;border-radius:18rpx;background:#fbfcff}.hint-row{display:flex;gap:12rpx;margin-top:22rpx}.hint-row button{flex:1;padding:0;font-size:23rpx;color:#46607f;background:#edf3fb}.hint-row button::after,.primary::after{border:0}.hint{margin-top:20rpx;padding:20rpx;border-radius:16rpx;background:#fff7e6}.hint text{display:block;line-height:1.6}.hint text:first-child{color:#987129;font-size:22rpx}.primary{margin-top:28rpx;color:#fff;background:#315c45}.feedback{margin-top:24rpx;padding:24rpx;border-radius:18rpx;line-height:1.65}.feedback.correct{background:#eaf8f1}.feedback.wrong{background:#fff0f0}.feedback text{display:block}.feedback-title{font-size:30rpx;font-weight:750}.feedback button{margin-top:18rpx}.finish{text-align:center;line-height:1.7}.finish-title{display:block;margin-bottom:16rpx;font-size:34rpx;font-weight:800}.partial{margin-top:24rpx;color:#687694;background:transparent;font-size:24rpx}.partial::after{border:0}
