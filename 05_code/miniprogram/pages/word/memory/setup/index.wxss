page{background:#f6f9ff;color:#13234d}.page{padding:38rpx}.title{display:block;font-size:46rpx;font-weight:800}.subtitle{display:block;margin-top:12rpx;color:#6b7894;font-size:25rpx}.card{margin-top:28rpx;padding:30rpx;border:1rpx solid #e1e8f1;border-radius:24rpx;background:#fff}.card-title{display:block;font-size:30rpx;font-weight:750}.option{display:flex;align-items:center;justify-content:space-between;margin-top:20rpx;padding:24rpx;border:2rpx solid #dce5f1;border-radius:18rpx}.option.selected{border-color:#315c45;background:#f0f8f4}.option>text{color:#315c45;font-size:34rpx;font-weight:800}.desc{display:block;margin-top:8rpx;color:#697691;font-size:23rpx;font-weight:400}.review{display:flex;align-items:center;justify-content:space-between}.notice{margin:24rpx 4rpx;color:#7b6332;font-size:23rpx;line-height:1.65}.primary{margin-top:34rpx;color:#fff;background:#315c45;border-radius:20rpx}.primary::after{border:0}.source-help{display:block;margin-top:10rpx;color:#697691;font-size:23rpx;line-height:1.6}.option.disabled{opacity:.55}.state{margin-top:30rpx;padding:70rpx 24rpx;border-radius:24rpx;background:#fff;text-align:center;color:#697691}.state text{display:block}.state button{width:220rpx;margin-top:24rpx;color:#315c45;background:#fff;border:2rpx solid #315c45}.state button::after{border:0}
