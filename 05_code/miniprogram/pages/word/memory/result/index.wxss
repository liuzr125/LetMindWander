page{background:#f5f8ff;color:#13234d}.page{padding:38rpx}.state{padding:140rpx 20rpx;text-align:center;color:#687694}.hero{text-align:center;color:#697691}.icon{display:flex;align-items:center;justify-content:center;width:118rpx;height:118rpx;margin:24rpx auto;border-radius:50%;color:#fff;background:#27a878;font-size:62rpx}.title{display:block;margin:20rpx 0 12rpx;color:#13234d;font-size:42rpx;font-weight:800}.grid{display:grid;grid-template-columns:repeat(2,1fr);gap:16rpx;margin-top:34rpx}.grid view{padding:25rpx;border-radius:20rpx;background:#fff}.grid text{display:block}.grid text:first-child{font-size:38rpx;font-weight:800}.grid text:last-child{margin-top:8rpx;color:#687694;font-size:22rpx}.card{margin-top:22rpx;padding:28rpx;border-radius:22rpx;background:#fff}.card>text{display:block}.weak{margin:8rpx 0;color:#d27531;font-size:50rpx;font-weight:800}.note{color:#687694;font-size:23rpx;line-height:1.65}.card-title{font-size:29rpx;font-weight:750}.review-row{display:flex;justify-content:space-between;margin-top:16rpx;padding-top:16rpx;border-top:1rpx solid #edf0f5}.review-row text:last-child{color:#687694}.primary,.secondary{margin-top:22rpx;border-radius:18rpx}.primary{color:#fff;background:#315c45}.secondary{color:#315c45;background:#fff;border:2rpx solid #315c45}.primary::after,.secondary::after{border:0}
