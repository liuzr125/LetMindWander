page{background:#f6f9ff;color:#0a174f}.settings-page{padding:30rpx 34rpx calc(80rpx + env(safe-area-inset-bottom))}.state{padding:140rpx 24rpx;text-align:center;color:#687694}.state text{display:block;margin-bottom:24rpx}.state button{width:220rpx;color:#126ade;background:#fff}.settings-intro{padding:8rpx 8rpx 22rpx}.intro-title,.intro-copy,.section-title,.section-caption,.setting-title,.setting-note,.section-footnote{display:block}.intro-title{font-size:42rpx;font-weight:800}.intro-copy{margin-top:10rpx;color:#687694;font-size:24rpx;line-height:1.65}.settings-card{margin-top:22rpx;padding:30rpx;border:1rpx solid #e1e7f0;border-radius:24rpx;background:#fff;box-shadow:0 8rpx 28rpx rgba(33,74,135,.06)}.section-head{padding-bottom:20rpx;border-bottom:1rpx solid #edf0f5}.section-title{font-size:31rpx;font-weight:750}.section-caption{margin-top:6rpx;color:#687694;font-size:22rpx;line-height:1.55}.setting-row{display:flex;align-items:center;justify-content:space-between;gap:22rpx;padding:24rpx 0;border-bottom:1rpx solid #edf0f5}.setting-row>view{flex:1;min-width:0}.setting-row switch{transform:scale(.84);transform-origin:right center}.setting-title{font-size:27rpx;font-weight:650;color:#1d2e50}.setting-note{margin-top:7rpx;color:#7c88a0;font-size:21rpx;line-height:1.55}.picker-list{margin-top:20rpx;border:1rpx solid #e0e7f1;border-radius:18rpx;overflow:hidden}.picker-row{display:flex;align-items:center;justify-content:space-between;gap:20rpx;padding:23rpx 20rpx;border-bottom:1rpx solid #edf0f5;color:#53627d;font-size:24rpx;background:#f8faff}.picker-list picker:last-child .picker-row{border-bottom:0}.picker-row text:last-child{color:#126ade;font-weight:650}.section-footnote{margin-top:20rpx;color:#7a869d;font-size:21rpx;line-height:1.65}.save-status{padding:26rpx 10rpx;text-align:center;color:#73809a;font-size:22rpx}.save-status text:nth-child(2){color:#168d69}
