page{background:#f6f8fd;color:#0b164e}.page{min-height:100vh;padding:34rpx 34rpx 210rpx;box-sizing:border-box}.hero{padding:20rpx 8rpx 30rpx}.book-mark{display:flex;align-items:center;justify-content:center;width:76rpx;height:76rpx;border-radius:22rpx;color:#fff;background:linear-gradient(145deg,#287df2,#5a9cff);font-size:30rpx;font-weight:750;box-shadow:0 12rpx 26rpx rgba(40,125,242,.22)}.title,.subtitle{display:block}.title{margin-top:24rpx;font-size:42rpx;font-weight:750}.subtitle{margin-top:14rpx;color:#657393;font-size:26rpx;line-height:1.65}.progress-entry{display:flex;align-items:center;margin-bottom:24rpx;padding:24rpx;border:2rpx solid #bed8ff;border-radius:20rpx;background:#eef6ff}.progress-entry>view{flex:1}.progress-name,.progress-count{display:block}.progress-name{font-size:27rpx;font-weight:700}.progress-count{margin-top:8rpx;color:#637390;font-size:23rpx}.progress-link{color:#0869f7;font-size:24rpx}.book-list{margin-top:4rpx}.book-card{display:flex;align-items:center;margin-top:18rpx;padding:28rpx 24rpx;border:2rpx solid #e3e9f3;border-radius:24rpx;background:#fff;box-shadow:0 8rpx 24rpx rgba(24,66,130,.05)}.book-card.selected{border-color:#4d91f6;background:#f5f9ff;box-shadow:0 10rpx 28rpx rgba(40,125,242,.12)}.book-card.disabled{opacity:.55}.book-icon{display:flex;align-items:center;justify-content:center;width:76rpx;height:92rpx;border-radius:12rpx 20rpx 20rpx 12rpx;color:#fff;background:#287df2;font-size:32rpx;font-weight:750;box-shadow:inset 8rpx 0 rgba(8,60,150,.16)}.book-main{flex:1;min-width:0;margin-left:24rpx}.book-title-row{display:flex;align-items:center}.book-title{font-size:31rpx;font-weight:700}.tag{margin-left:12rpx;padding:4rpx 10rpx;border-radius:999rpx;color:#1767d7;background:#dceaff;font-size:20rpx}.book-desc,.book-meta{display:block}.book-desc{margin-top:9rpx;color:#52617d;font-size:24rpx}.book-meta{margin-top:8rpx;color:#8a96aa;font-size:22rpx}.radio{display:flex;align-items:center;justify-content:center;width:38rpx;height:38rpx;margin-left:18rpx;border:3rpx solid #c6cfdd;border-radius:50%;box-sizing:border-box}.selected .radio{border-color:#287df2}.radio view{width:20rpx;height:20rpx;border-radius:50%;background:#287df2}.preparing{margin-left:16rpx;color:#7b879c;font-size:21rpx}.state{margin-top:30rpx;padding:60rpx 24rpx;border-radius:24rpx;color:#657393;background:#fff;text-align:center}.state text{display:block}.state button{width:180rpx;margin-top:24rpx;color:#287df2;background:#fff;border:2rpx solid #287df2}.bottom-bar{position:fixed;right:0;bottom:0;left:0;padding:22rpx 34rpx 34rpx;background:rgba(255,255,255,.96);border-top:1rpx solid #e7ebf2}.confirm{height:88rpx;border-radius:18rpx;color:#fff;background:#0869f7;font-size:30rpx;line-height:88rpx}.confirm[disabled]{color:#fff;background:#a9c7ee}.confirm::after{border:0}.tip{display:block;margin-top:13rpx;color:#8792a7;font-size:21rpx;text-align:center}
