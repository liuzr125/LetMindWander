page{background:#f5f8fe;color:#0b164e}
.page{min-height:100vh;padding:32rpx 34rpx 70rpx;box-sizing:border-box}
.state,.empty{margin-top:40rpx;padding:70rpx 30rpx;border-radius:24rpx;background:#fff;color:#687693;text-align:center}
.state text{display:block}.state button{width:220rpx;margin-top:26rpx;color:#0869f7;background:#fff;border:2rpx solid #0869f7}.state .primary{color:#fff;background:#0869f7}
.summary-card{padding:34rpx;border:2rpx solid #bdd8ff;border-radius:26rpx;background:linear-gradient(135deg,#f9fcff,#e9f3ff);box-shadow:0 12rpx 34rpx rgba(30,94,180,.09)}
.summary-head{display:flex;align-items:center}.summary-head>view{flex:1}.eyebrow,.book-name{display:block}.eyebrow{color:#6b7893;font-size:22rpx}.book-name{margin-top:8rpx;font-size:35rpx;font-weight:750}.change{color:#0869f7;font-size:24rpx}
.rate-row{display:flex;align-items:baseline;margin-top:28rpx}.rate{color:#0869f7;font-size:68rpx;font-weight:760}.rate text{font-size:34rpx}.rate-copy{margin-left:14rpx;color:#62718f;font-size:24rpx}
.track{height:18rpx;margin-top:16rpx;border-radius:99rpx;background:#cbdcf5;overflow:hidden}.bar{height:100%;border-radius:99rpx;background:#287df2}
.metrics{display:flex;margin-top:30rpx;padding-top:26rpx;border-top:1rpx solid #d7e4f6}.metrics view{flex:1;text-align:center;color:#687693;font-size:22rpx}.metrics view+view{border-left:1rpx solid #d7e4f6}.metric-number{display:block;margin-bottom:6rpx;color:#162451;font-size:38rpx;font-weight:730}.metric-number.learned{color:#178c68}
.forecast{display:flex;align-items:center;justify-content:space-between;margin-top:22rpx;padding:18rpx 20rpx;border-radius:14rpx;background:rgba(255,255,255,.72);color:#526589;font-size:24rpx}.forecast-days{color:#0869f7;font-weight:700}.forecast-arrow{flex:none;margin-left:14rpx;color:#0869f7;font-weight:600}
.tabs{display:flex;margin:28rpx 0 18rpx;padding:7rpx;border-radius:18rpx;background:#e9eef7}.tab{flex:1;padding:18rpx 0;border-radius:14rpx;color:#69758d;text-align:center;font-size:25rpx}.tab.selected{color:#0b164e;background:#fff;font-weight:700;box-shadow:0 4rpx 14rpx rgba(22,52,100,.08)}
.word-list{overflow:hidden;border:1rpx solid #e1e7f0;border-radius:22rpx;background:#fff}.word-row{display:flex;align-items:center;min-height:112rpx;padding:20rpx 24rpx;border-bottom:1rpx solid #e9edf3}.word-row:last-child{border-bottom:0}.word-main{flex:1;min-width:0}.word-main>view{display:flex;align-items:baseline}.word{font-size:31rpx;font-weight:700}.phonetic{margin-left:14rpx;color:#8590a5;font-size:21rpx}.meaning{display:block;margin-top:8rpx;color:#5e6b83;font-size:24rpx;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.word-status{padding:7rpx 13rpx;border-radius:999rpx;color:#7a879e;background:#eef1f6;font-size:21rpx}.word-status.done{color:#16845f;background:#e3f5ed}.arrow{margin-left:10rpx;color:#9aa5b7;font-size:34rpx}.more{display:block;padding:28rpx;color:#8994a8;text-align:center;font-size:22rpx}
