<view class="learn-page">
  <view class="hero"><text class="title">学习</text><text class="subtitle">按自己的节奏，理解新知。</text></view>
  <view class="primary-tabs"><view class="{{primaryTab === 'tech' ? 'selected' : ''}}" data-value="tech" bindtap="switchPrimary">技术</view><view class="{{primaryTab === 'english' ? 'selected' : ''}}" data-value="english" bindtap="switchPrimary">英语</view></view>

  <view wx:if="{{primaryTab === 'english'}}" class="english-tabs"><view class="{{englishTab === 'vocabulary' ? 'selected' : ''}}" data-value="vocabulary" bindtap="switchEnglish">词汇</view><view class="{{englishTab === 'notebook' ? 'selected' : ''}}" data-value="notebook" bindtap="switchEnglish">生词本</view><view class="{{englishTab === 'article' ? 'selected' : ''}}" data-value="article" bindtap="switchEnglish">短文</view></view>

  <block wx:if="{{primaryTab === 'tech'}}">
    <view class="compact-filters">
      <picker class="filter-picker" mode="selector" range="{{topics}}" range-key="name" value="{{topicIndex}}" bindchange="changeTopic"><view class="filter-select"><text class="filter-name">主题</text><text class="filter-value">{{topics[topicIndex].name}}</text><text class="filter-arrow">⌄</text></view></picker>
      <picker wx:if="{{difficulties.length}}" class="filter-picker" mode="selector" range="{{difficulties}}" range-key="label" value="{{difficultyIndex}}" bindchange="changeDifficulty"><view class="filter-select"><text class="filter-name">难度</text><text class="filter-value">{{difficulties[difficultyIndex].label}}</text><text class="filter-arrow">⌄</text></view></picker>
    </view>
  </block>
  <block wx:elif="{{englishTab === 'vocabulary'}}">
    <view class="memory-entry" bindtap="startWordMemory"><view><text class="memory-entry-title">单词记忆测试</text><text class="memory-entry-copy">测试今日或当前词书中已经学习过的单词</text></view><text class="memory-entry-arrow">›</text></view>
    <view class="search-row"><text class="search-icon">⌕</text><input value="{{keyword}}" bindinput="onKeywordInput" bindconfirm="searchWords" confirm-type="search" placeholder="搜索单词、释义或别名"/><text wx:if="{{keyword}}" bindtap="clearKeyword">×</text></view>
    <view wx:if="{{stages.length && difficulties.length}}" class="compact-filters">
      <picker class="filter-picker" mode="selector" range="{{stages}}" range-key="label" value="{{stageIndex}}" bindchange="changeStage"><view class="filter-select"><text class="filter-name">学段</text><text class="filter-value">{{stages[stageIndex].label}}</text><text class="filter-arrow">⌄</text></view></picker>
      <picker class="filter-picker" mode="selector" range="{{difficulties}}" range-key="label" value="{{difficultyIndex}}" bindchange="changeDifficulty"><view class="filter-select"><text class="filter-name">难度</text><text class="filter-value">{{difficulties[difficultyIndex].label}}</text><text class="filter-arrow">⌄</text></view></picker>
    </view>
  </block>
  <block wx:elif="{{englishTab === 'notebook'}}">
    <view class="search-row"><text class="search-icon">⌕</text><input value="{{keyword}}" bindinput="onKeywordInput" bindconfirm="searchWords" confirm-type="search" placeholder="搜索生词、释义或别名"/><text wx:if="{{keyword}}" bindtap="clearKeyword">×</text></view>
    <view wx:if="{{notebookStatuses.length}}" class="compact-filters single"><picker class="filter-picker" mode="selector" range="{{notebookStatuses}}" range-key="label" value="{{notebookStatusIndex}}" bindchange="changeNotebookStatus"><view class="filter-select"><text class="filter-name">状态</text><text class="filter-value">{{notebookStatuses[notebookStatusIndex].label}}</text><text class="filter-arrow">⌄</text></view></picker></view>
    <view class="notebook-summary"><view><text>我的生词</text><text class="count">{{notebookSummary.totalCount}}</text></view><view><text>今日待复习</text><text class="count">{{notebookSummary.dueCount}}</text></view></view>
  </block>
  <block wx:else>
    <view wx:if="{{difficulties.length}}" class="compact-filters single"><picker class="filter-picker" mode="selector" range="{{difficulties}}" range-key="label" value="{{difficultyIndex}}" bindchange="changeDifficulty"><view class="filter-select"><text class="filter-name">难度</text><text class="filter-value">{{difficulties[difficultyIndex].label}}</text><text class="filter-arrow">⌄</text></view></picker></view>
    <view class="section-heading"><text>短文阅读</text><text class="section-copy">每天一小篇，读懂技术英语。</text></view>
  </block>

  <view wx:if="{{loading}}" class="state-card">正在加载学习内容…</view>
  <view wx:elif="{{error}}" class="state-card"><text>{{error}}</text><button bindtap="retry">重试</button></view>
  <view wx:elif="{{!items.length}}" class="state-card"><text>{{englishTab === 'notebook' ? '还没有符合条件的生词' : '暂时没有符合条件的学习内容'}}</text></view>

  <view wx:else class="content-list">
    <view wx:for="{{items}}" wx:key="contentId" class="content-card {{item.contentType}}" data-id="{{item.contentId}}" data-type="{{item.contentType}}" bindtap="openItem">
      <block wx:if="{{item.contentType === 'tech'}}"><text class="card-title">{{item.title}}</text><view class="meta"><text>{{item.topicName || item.difficultyLabel}}</text><text>预计 {{item.minuteText}} 分钟</text><text class="status {{item.understood ? 'done' : ''}}">{{item.statusLabel}}</text></view><text class="summary">{{item.summary}}</text><text class="card-mark">▤</text></block>
      <block wx:elif="{{item.contentType === 'word'}}"><view class="word-main"><text class="word">{{item.wordTerm || item.title}}</text><text class="phonetic">{{item.phonetic}}</text><text class="meaning">{{item.meaning}}</text><text class="example">{{item.exampleText}}</text><view class="meta"><text wx:if="{{item.stageLabel}}">{{item.stageLabel}}</text><text>{{item.difficultyLabel}}</text><text class="status {{item.understood ? 'done' : ''}}">{{item.statusLabel}}</text></view><view wx:if="{{englishTab === 'notebook'}}" class="familiarity"><text>熟悉度 {{item.familiarityValue}}%</text><view><view class="familiarity-bar" style="width:{{item.familiarityValue}}%;"></view></view></view></view></block>
      <block wx:else><text class="card-title">{{item.title}}</text><text class="summary">{{item.summary}}</text><view class="meta"><text>{{item.difficultyLabel}}</text><text wx:if="{{item.topicName}}">{{item.topicName}}</text><text>{{item.wordCount}} 词 · 预计 {{item.minuteText}} 分钟</text><text class="status {{item.understood ? 'done' : ''}}">{{item.understood ? '已读' : '未读'}}</text></view><text class="card-mark">▥</text></block>
    </view>
    <view wx:if="{{loadingMore}}" class="load-more">正在加载更多…</view>
  </view>
  <button wx:if="{{primaryTab === 'english' && englishTab === 'notebook' && notebookSummary.dueCount}}" class="review-button" bindtap="startReview">开始复习 · {{notebookSummary.dueCount}} 个</button>
</view>
