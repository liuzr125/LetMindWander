page{background:#f7f9ff;color:#09164c}
.learn-page{min-height:100vh;padding:36rpx 40rpx 120rpx;background:linear-gradient(180deg,#f9fbff,#f4f7fc)}
.hero{padding:12rpx 2rpx 32rpx}.title,.subtitle{display:block}.title{font-size:54rpx;font-weight:800}.subtitle{margin-top:14rpx;color:#667493;font-size:28rpx}
.primary-tabs{display:flex;height:86rpx;border:2rpx solid #d9e1ec;border-radius:18rpx;overflow:hidden;background:rgba(255,255,255,.8)}.primary-tabs view{display:flex;align-items:center;justify-content:center;flex:1;color:#43506c;font-size:32rpx}.primary-tabs .selected{color:#0869f7;background:#eaf2ff;border:1rpx solid #aac9ff}
.english-tabs{display:flex;margin:30rpx 4rpx 18rpx}.english-tabs view{position:relative;flex:1;padding:18rpx 0;text-align:center;color:#4e5c78;font-size:28rpx}.english-tabs .selected{color:#0869f7;font-weight:650}.english-tabs .selected::after{content:"";position:absolute;left:34%;right:34%;bottom:0;height:4rpx;border-radius:9rpx;background:#0869f7}
.filter-row{display:flex;gap:16rpx;margin-top:18rpx;white-space:nowrap}.chip{display:inline-flex;align-items:center;justify-content:center;flex-shrink:0;min-width:104rpx;height:66rpx;padding:0 24rpx;border:2rpx solid #dfe5ee;border-radius:16rpx;color:#4d5870;background:#fff}.chip.selected{color:#0869f7;border-color:#0869f7;background:#f6f9ff}
.compact-filters{display:flex;gap:16rpx;margin-top:18rpx}.filter-picker{flex:1;min-width:0}.compact-filters.single .filter-picker{flex:0 0 280rpx}.filter-select{display:flex;align-items:center;height:68rpx;padding:0 20rpx;border:1rpx solid #dfe5ee;border-radius:16rpx;background:#fff}.filter-name{color:#75819a;font-size:23rpx}.filter-value{flex:1;margin-left:16rpx;color:#10204f;font-size:26rpx;font-weight:650}.filter-arrow{color:#7b879d;font-size:28rpx}
.search-row{display:flex;align-items:center;gap:16rpx;height:82rpx;margin-top:20rpx;padding:0 24rpx;border:1rpx solid #e0e6ef;border-radius:19rpx;background:#fff;color:#687693}.search-row input{flex:1;font-size:26rpx}.search-icon{font-size:40rpx}
.memory-entry{display:flex;align-items:center;justify-content:space-between;margin-top:20rpx;padding:24rpx 26rpx;border:1rpx solid #cfe0d8;border-radius:20rpx;background:linear-gradient(135deg,#f7fcf9,#edf8f2)}.memory-entry-title,.memory-entry-copy{display:block}.memory-entry-title{color:#244f3d;font-size:28rpx;font-weight:750}.memory-entry-copy{margin-top:7rpx;color:#64786f;font-size:22rpx}.memory-entry-arrow{color:#315c45;font-size:38rpx}
.notebook-summary{display:flex;margin-top:22rpx;padding:24rpx 28rpx;border:2rpx solid #c9ddff;border-radius:20rpx;background:linear-gradient(135deg,#f9fcff,#eef5ff)}.notebook-summary view{display:flex;flex:1;flex-direction:column}.notebook-summary view+view{padding-left:28rpx;border-left:1rpx solid #d8e4f5}.notebook-summary text{color:#40506d}.notebook-summary .count{margin-top:8rpx;color:#0869f7;font-size:38rpx;font-weight:700}
.section-heading{margin:28rpx 4rpx 8rpx}.section-heading text{display:block}.section-heading>text:first-child{font-size:34rpx;font-weight:750}.section-heading .section-copy{margin-top:8rpx;color:#687693;font-size:24rpx}
.state-card{margin-top:32rpx;padding:80rpx 28rpx;border-radius:24rpx;background:#fff;text-align:center;color:#697795;box-shadow:0 9rpx 28rpx rgba(28,66,126,.06)}.state-card button{width:180rpx;margin-top:24rpx;color:#0869f7;background:#fff;border:2rpx solid #0869f7}.state-card button::after{border:0}
.content-list{margin-top:26rpx}.content-card{position:relative;display:flex;min-height:190rpx;margin-top:20rpx;padding:30rpx 34rpx;border:1rpx solid #e0e6ef;border-radius:24rpx;background:#fff;box-shadow:0 9rpx 26rpx rgba(28,66,126,.07);overflow:hidden}.content-card.tech,.content-card.english_article{display:block;padding-right:120rpx}.card-title,.summary{display:block}.card-title{font-size:33rpx;font-weight:760;line-height:1.4}.summary{margin-top:22rpx;color:#32405d;font-size:26rpx;line-height:1.65}.meta{display:flex;flex-wrap:wrap;align-items:center;gap:14rpx;margin-top:16rpx;color:#667493;font-size:23rpx}.meta text:not(.status){color:#0869f7}.status{margin-left:auto;padding:6rpx 14rpx;border-radius:10rpx;background:#f0f3f8}.status.done{color:#129b62;background:#e9f7f0}.card-mark{position:absolute;right:34rpx;top:62rpx;color:#4f92f5;font-size:62rpx}
.word-main{flex:1;min-width:0}.word{font-size:37rpx;font-weight:800}.phonetic{margin-left:18rpx;color:#697591}.meaning,.example{display:block;margin-top:10rpx}.meaning{font-size:28rpx}.example{overflow:hidden;color:#65718b;font-size:23rpx;text-overflow:ellipsis;white-space:nowrap}.familiarity{margin-top:14rpx;color:#65718c;font-size:21rpx}.familiarity>view{width:360rpx;height:10rpx;margin-top:8rpx;border-radius:99rpx;background:#dce8f8;overflow:hidden}.familiarity-bar{height:100%;background:#1b78f6}
.load-more{padding:34rpx;text-align:center;color:#7a879f}.review-button{position:sticky;bottom:24rpx;margin-top:28rpx;color:#fff;background:#0869f7;border-radius:18rpx;box-shadow:0 10rpx 30rpx rgba(8,105,247,.25)}.review-button::after{border:0}
