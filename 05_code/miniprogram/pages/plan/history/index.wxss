page { background:#f7f9ff; color:#101448; }
.history-page { min-height:100vh; background:#f7f9ff; }.content { padding:30rpx 32rpx; }.page-tip { display:block; padding:0 8rpx 24rpx; color:#7180a2; font-size:24rpx; line-height:1.6; }.plan-card { margin-bottom:20rpx; padding:28rpx; border-radius:22rpx; background:#fff; box-shadow:0 6rpx 24rpx rgba(70,97,145,.06); }.card-head { display:flex; align-items:center; justify-content:space-between; margin-bottom:20rpx; }.version { color:#101448; font-size:30rpx; font-weight:700; }.effective { color:#0869f7; font-size:23rpx; }.summary,.topics,.tasks,.paused { display:block; margin-top:12rpx; color:#53678f; font-size:24rpx; line-height:1.5; }.summary { color:#1e2c4d; }.paused { color:#d36b2e; }.empty { padding-top:230rpx; text-align:center; }.empty-title,.empty-text { display:block; }.empty-title { color:#17264b; font-size:31rpx; font-weight:700; }.empty-text { margin-top:18rpx; color:#7180a2; font-size:25rpx; }
