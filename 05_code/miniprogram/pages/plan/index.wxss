page { background:#f7f9ff; color:#101448; }
.plan-page { min-height:100vh; background:#f7f9ff; }
.content { padding:30rpx 42rpx calc(38rpx + env(safe-area-inset-bottom)); }
.section { margin-bottom:42rpx; }
.section-title { display:block; color:#0b164e; font-size:34rpx; font-weight:700; margin-bottom:22rpx; }
.section-subtitle,.topic-hint { display:block; color:#647397; font-size:24rpx; margin:-8rpx 0 22rpx; }
.budget-list,.week-list,.topic-list,.difficulty-list { display:flex; flex-wrap:wrap; gap:18rpx; }
.budget { box-sizing:border-box; min-width:120rpx; height:72rpx; line-height:70rpx; padding:0 20rpx; border:2rpx solid #e0e5ee; border-radius:16rpx; color:#141414; font-size:27rpx; text-align:center; background:#fff; }
.budget.selected { background:#0869f7; color:#fff; border-color:#0869f7; box-shadow:0 8rpx 16rpx rgba(8,105,247,.18); }
.weekdays-section { margin-bottom:36rpx; }.week-list { justify-content:space-between; gap:0; }
.week { box-sizing:border-box; width:66rpx; height:66rpx; line-height:62rpx; border:2rpx solid #e0e5ee; border-radius:50%; color:#111; background:#fff; text-align:center; font-size:30rpx; }.week.selected { color:#fff; background:#0869f7; border-color:#0869f7; }
.divider { height:1rpx; background:#e4e8ee; margin:0 0 38rpx; }
.topic { box-sizing:border-box; height:70rpx; padding:0 30rpx; line-height:66rpx; border:2rpx solid #e0e5ee; border-radius:14rpx; font-size:27rpx; color:#151515; background:#fff; }.topic.selected { color:#0869f7; border-color:#0869f7; background:#f7faff; }
.topic-input-row { display:flex; align-items:center; gap:16rpx; margin-top:22rpx; }.topic-input { flex:1; min-width:0; box-sizing:border-box; height:72rpx; padding:0 22rpx; border:2rpx solid #e0e5ee; border-radius:14rpx; background:#fff; font-size:25rpx; }.add-button { flex:0 0 126rpx; margin:0; padding:0; height:72rpx; line-height:72rpx; border-radius:14rpx; color:#fff; background:#0869f7; font-size:27rpx; }.add-button::after,.actions button::after { border:0; }
.difficulty-section { margin-bottom:34rpx; }.difficulty { box-sizing:border-box; flex:1; height:72rpx; line-height:68rpx; text-align:center; border:2rpx solid #e0e5ee; border-radius:14rpx; background:#fff; color:#161616; font-size:28rpx; }.difficulty.selected { color:#0869f7; border-color:#0869f7; }
.task-row,.toggle-row,.limit-row { display:flex; align-items:center; justify-content:space-between; min-height:94rpx; }.row-title { color:#0b164e; font-size:32rpx; font-weight:700; }.question { display:inline-flex; justify-content:center; align-items:center; width:28rpx; height:28rpx; border:2rpx solid #66759a; border-radius:50%; color:#66759a; font-size:20rpx; vertical-align:4rpx; }.row-note,.limit-label { color:#647397; font-size:26rpx; font-weight:400; }.stepper { display:flex; align-items:center; height:64rpx; border:1rpx solid #e1e6ee; border-radius:14rpx; overflow:hidden; background:#fff; }.count-entry { display:flex; align-items:center; justify-content:center; width:136rpx; height:64rpx; }.count-entry input { width:68rpx; height:62rpx; padding:0; color:#121212; font-size:28rpx; text-align:right; }.count-entry text { width:32rpx; color:#121212; font-size:28rpx; text-align:left; }.step { width:58rpx; height:64rpx; line-height:61rpx; text-align:center; color:#111; font-size:32rpx; border-right:1rpx solid #e1e6ee; }.step:last-child { border-right:0; border-left:1rpx solid #e1e6ee; }.toggle-row switch { transform:scale(.85); transform-origin:right center; }.limit-row { min-height:76rpx; }.limit-picker { min-width:120rpx; height:58rpx; line-height:58rpx; border:1rpx solid #e0e5ee; border-radius:12rpx; background:#fff; text-align:center; color:#181818; font-size:26rpx; }
.preview-card { display:flex; align-items:center; gap:28rpx; margin-top:30rpx; padding:30rpx; border:1rpx solid #dee6f2; border-radius:24rpx; background:linear-gradient(110deg,#fff,#f0f6ff); }.calendar { color:#0869f7; font-size:60rpx; }.preview-title,.preview-detail { display:block; }.preview-title { color:#0b164e; font-size:31rpx; font-weight:700; margin-bottom:12rpx; }.preview-detail { color:#647397; font-size:24rpx; }.notice { display:flex; justify-content:space-between; align-items:center; padding:34rpx 4rpx 20rpx; color:#647397; font-size:23rpx; }.pause { color:#0869f7; font-size:28rpx; font-weight:600; }.actions { display:flex; gap:20rpx; }.actions button { flex:1; margin:0; height:84rpx; line-height:84rpx; border-radius:16rpx; font-size:31rpx; font-weight:600; }.adjust { color:#0869f7; background:#fff; border:2rpx solid #0869f7; }.save { color:#fff; background:#0869f7; }.error { display:block; margin:0 0 18rpx; color:#cf3947; font-size:23rpx; }.loading { padding-top:180rpx; text-align:center; color:#647397; font-size:27rpx; }
.success-toast { position:fixed; z-index:200; left:50%; top:44%; display:flex; align-items:center; justify-content:center; gap:16rpx; width:420rpx; min-height:112rpx; padding:24rpx 28rpx; box-sizing:border-box; transform:translate(-50%,-50%); border-radius:18rpx; background:rgba(31,31,31,.86); color:#fff; font-size:28rpx; line-height:1.45; text-align:center; }.success-icon { display:inline-flex; align-items:center; justify-content:center; flex:0 0 38rpx; width:38rpx; height:38rpx; border:3rpx solid #fff; border-radius:50%; font-size:25rpx; }
