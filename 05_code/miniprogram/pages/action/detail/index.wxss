page{background:#f7f9ff;color:#101b4b}.action-page{min-height:100vh;padding:38rpx 40rpx 80rpx}.state{padding:120rpx 20rpx;text-align:center;color:#71809a}.state button{width:180rpx;margin-top:24rpx}.eyebrow{display:block;color:#1475f5;font-size:24rpx;font-weight:700}.headline{display:block;margin-top:12rpx;font-size:44rpx;font-weight:760}.date-card,.form-card,.hint{margin-top:28rpx;padding:28rpx;border:1rpx solid #dce5f3;border-radius:20rpx;background:#fff}.date-card{display:flex;justify-content:space-between;color:#576681}.form-card .label{display:block;margin:26rpx 0 12rpx;color:#495979;font-size:24rpx}.form-card .label:first-child{margin-top:0}.form-card input,.form-card textarea{box-sizing:border-box;width:100%;padding:20rpx;border:1rpx solid #d8e1ef;border-radius:14rpx;background:#fbfcff}.form-card textarea{height:180rpx}.hint{color:#7b879f;font-size:23rpx;line-height:1.6}.save,.complete{margin-top:28rpx;height:86rpx;line-height:86rpx;border-radius:14rpx}.save{color:#196de8;background:#eef5ff}.complete{color:#fff;background:#126ff4}.save::after,.complete::after{border:0}
