<view class="page-shell">
  <text class="eyebrow">TODAY · {{today}}</text>
  <text class="page-title">今日任务</text>
  <view wx:if="{{loading}}" class="hint">正在准备今天的任务…</view>
  <view wx:elif="{{error}}" class="hint"><text>{{error}}</text><button size="mini" bindtap="load">重试</button></view>
  <block wx:elif="{{!pack.active}}"><view class="empty-card"><text class="empty-title">{{pack.message || '暂无任务'}}</text><text class="empty-copy">自由浏览不会计入今日进度。</text><button wx:if="{{pack.nonActiveDay}}" class="primary-button" bindtap="activate">今天也学习</button></view></block>
  <block wx:else><view class="progress-card"><view><text class="progress-number">{{pack.doneCount}}/{{pack.currentCount}}</text><text class="progress-label"> 已完成</text></view><text wx:if="{{pack.completionRate != null}}" class="rate">{{pack.completionRate}}%</text><text wx:else class="rate">暂无任务</text></view><view wx:if="{{pack.tasks.length}}" class="task-list"><view wx:for="{{pack.tasks}}" wx:key="id" class="task" bindtap="changeTask" data-task="{{item}}"><view class="status {{item.status}}">{{item.status === 'DONE' ? '✓' : item.status === 'DOING' ? '·' : '○'}}</view><view class="task-copy"><text class="task-title">{{item.title}}</text><text class="task-meta">{{item.estimatedSeconds / 60}} 分钟 · {{item.status}}</text></view></view></view><view wx:else class="empty-card"><text class="empty-title">暂无任务</text><text class="empty-copy">内容不足时不会凭空安排任务。</text></view><view wx:if="{{pack.gaps.length}}" class="gap"><text>今日缺项</text><text wx:for="{{pack.gaps}}" wx:key="taskType">{{item.taskType}}：{{item.reason}} </text></view></block>
</view>
