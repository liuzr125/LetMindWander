<view class="today-page">
  <view class="hero">
    <text class="date">{{dateText}}</text>
    <text class="title">{{packActive ? '今天，向前一点点' : '今天，按自己的节奏来'}}</text>
    <text class="subtitle">{{packActive ? '每一点投入，都在积累。' : '专注学习，持续进步。'}}</text>
  </view>
  <view wx:if="{{loading}}" class="state-card">正在准备今天的任务…</view>
  <view wx:elif="{{error}}" class="state-card"><text>{{error}}</text><button class="outline-small" bindtap="load">重试</button></view>
  <block wx:elif="{{!pack.active || !pack.currentCount}}">
    <view class="empty-card">
      <view class="empty-icon">✓</view><text class="empty-title">暂无计划任务</text>
      <text class="empty-copy">{{pack.message || '今天不在你的计划内。'}}</text>
      <button class="primary-button" bindtap="activate">今天也学习</button>
      <button class="secondary-button" bindtap="openLearn">去学习页看看</button>
    </view>
  </block>
  <block wx:else>
    <view class="progress-card">
      <view class="progress-head"><text>已完成 {{pack.doneCount}} / {{pack.currentCount}}</text><text class="adjust" bindtap="adjustToday">调整今日 ›</text></view>
      <text class="rate">{{pack.completionRate}}<text class="percent">%</text></text>
      <view class="track"><view class="bar" style="width: {{pack.completionRate}}%;"></view></view>
      <view class="progress-foot"><text>原计划 {{pack.originalCount || pack.currentCount}} 项</text><text>剩余预计 {{remainingMinutes}} 分钟</text></view>
    </view>
    <view class="group-list">
      <view wx:for="{{groups}}" wx:key="type" class="task-group" bindtap="openGroup" data-type="{{item.type}}">
        <view class="group-icon {{item.color}}">{{item.done === item.total ? '✓' : item.icon}}</view>
        <view class="group-main"><text class="group-title">{{item.title}}</text><text class="group-status {{item.done === item.total ? 'complete' : ''}}">{{item.statusText}}</text></view>
        <text class="group-action">{{item.done === item.total ? '查看' : (item.type === 'review' ? '去复习' : '继续学习')}}</text><text class="chevron">›</text>
      </view>
    </view>
    <view wx:if="{{hasGaps}}" class="gap-card"><text class="gap-title">今日未安排</text><text wx:for="{{pack.gaps}}" wx:key="taskType">{{item.label}}：{{item.reason}}，少 {{item.gapCount}} 项</text></view>
  </block>
  <view class="history-card" bindtap="openJournalHistory"><text>复盘历史</text><text>›</text></view>
</view>
