page{background:#f7f9ff;color:#0b164e}.today-page{min-height:100vh;padding:34rpx 42rpx 72rpx;background:linear-gradient(180deg,#f9fbff,#f4f7fc)}
.hero{padding:14rpx 2rpx 28rpx}.date,.title,.subtitle{display:block}.date{font-size:28rpx}.title{margin-top:22rpx;font-size:46rpx;font-weight:750;letter-spacing:1rpx}.subtitle{margin-top:14rpx;color:#657393;font-size:27rpx}
.state-card,.empty-card,.progress-card,.task-group,.history-card,.gap-card{background:#fff;border:1rpx solid #e4eaf4;border-radius:24rpx;box-shadow:0 10rpx 30rpx rgba(24,66,130,.06)}.state-card{padding:42rpx;text-align:center;color:#657393}
.outline-small{width:180rpx;margin-top:24rpx;color:#0869f7;background:#fff;border:2rpx solid #0869f7}.empty-card{padding:72rpx 34rpx;text-align:center}.empty-icon{width:150rpx;height:150rpx;margin:0 auto 36rpx;line-height:150rpx;border-radius:36rpx;background:#eaf2ff;color:#8eb7fb;font-size:72rpx}.empty-title,.empty-copy{display:block}.empty-title{font-size:37rpx;font-weight:700}.empty-copy{margin-top:16rpx;color:#74809a}.primary-button,.secondary-button{height:84rpx;margin-top:38rpx;border-radius:15rpx;font-size:30rpx;line-height:84rpx}.primary-button{color:#fff;background:#0869f7}.secondary-button{margin-top:18rpx;color:#0869f7;background:#fff;border:2rpx solid #0869f7}.primary-button::after,.secondary-button::after,.outline-small::after{border:0}
.progress-card{padding:38rpx;background:linear-gradient(130deg,#f9fcff,#e9f3ff);border-color:#b7d4ff}.progress-head,.progress-foot{display:flex;justify-content:space-between;align-items:center}.progress-head{font-size:30rpx}.adjust,.group-action{color:#0869f7}.rate{display:block;margin:18rpx 0 20rpx;color:#0869f7;font-size:78rpx;font-weight:750}.percent{font-size:42rpx}.track{height:20rpx;border-radius:99rpx;background:#cfe0f8;overflow:hidden}.bar{height:100%;border-radius:99rpx;background:#0869f7}.progress-foot{margin-top:24rpx;color:#657393;font-size:25rpx}
.group-list{margin-top:26rpx}.task-group{display:flex;align-items:center;min-height:116rpx;margin-top:18rpx;padding:20rpx 24rpx}.group-icon{display:flex;align-items:center;justify-content:center;width:64rpx;height:64rpx;border-radius:50%;color:#fff;font-weight:700}.green{background:#34ad82}.blue{background:#287df2}.orange{background:#ff9c24}.purple{background:#8058e8}.cyan{background:#19a9bb}.group-main{flex:1;min-width:0;margin-left:24rpx}.group-title,.group-status{display:block}.group-title{font-size:33rpx;font-weight:700}.group-status{margin-top:8rpx;color:#657393;font-size:24rpx}.group-status.complete{color:#25a877}.group-action{font-size:26rpx}.chevron{margin-left:10rpx;color:#8b96aa;font-size:42rpx}
.gap-card{margin-top:24rpx;padding:26rpx;color:#9b6b20;background:#fffaf1;border-color:#f5d99c}.gap-card text{display:block;margin-top:8rpx}.gap-title{margin-top:0!important;font-weight:700}.history-card{display:flex;justify-content:space-between;margin-top:28rpx;padding:30rpx 34rpx;font-size:32rpx;font-weight:650}
