page { background: #fff; }
.invite-page { min-height: 100vh; padding-left: 46rpx; padding-right: 46rpx; padding-bottom: calc(28rpx + env(safe-area-inset-bottom)); background: radial-gradient(circle at 72% 18%, rgba(27,112,255,.055), transparent 33%), #fff; color: #081431; }
.brand { display: flex; flex-direction: column; align-items: center; padding-top: 54rpx; }
.brand-logo { position: relative; width: 92rpx; height: 92rpx; border-radius: 23rpx; background: linear-gradient(155deg, #1684ff, #075ce8); box-shadow: 0 10rpx 24rpx rgba(9,103,240,.22); }
.stem { position: absolute; left: 44rpx; bottom: 20rpx; width: 5rpx; height: 36rpx; background: #fff; border-radius: 6rpx; }
.stem::after { content: ''; position: absolute; left: -17rpx; bottom: -2rpx; width: 38rpx; height: 4rpx; background: #fff; border-radius: 6rpx; }
.leaf { position: absolute; top: 26rpx; width: 30rpx; height: 21rpx; background: #fff; }
.leaf-left { left: 18rpx; border-radius: 24rpx 4rpx 24rpx 4rpx; transform: rotate(20deg); }
.leaf-right { right: 18rpx; border-radius: 4rpx 24rpx 4rpx 24rpx; transform: rotate(-20deg); }
.brand-name { margin-top: 24rpx; font-size: 45rpx; font-weight: 700; letter-spacing: 2rpx; }
.brand-slogan { margin-top: 9rpx; color: #8790a5; font-size: 25rpx; }
.features { display: flex; justify-content: space-between; margin: 54rpx 12rpx 34rpx; }
.feature { width: 138rpx; display: flex; flex-direction: column; align-items: center; }
.feature-icon { position: relative; width: 74rpx; height: 74rpx; border: 2rpx solid #e6ebf4; border-radius: 50%; background: #fff; }
.feature-title { margin-top: 12rpx; font-size: 25rpx; font-weight: 650; }
.feature-copy { margin-top: 3rpx; color: #8790a5; font-size: 20rpx; white-space: nowrap; }
.feature-icon::before,.feature-icon::after,.feature-icon i::before,.feature-icon i::after { content: ''; position: absolute; box-sizing: border-box; }
.icon-book::before { left: 17rpx; top: 20rpx; width: 19rpx; height: 30rpx; border: 4rpx solid #0872fa; border-right: 2rpx solid #0872fa; border-radius: 4rpx 0 0 4rpx; transform: skewY(12deg); }
.icon-book::after { right: 17rpx; top: 20rpx; width: 19rpx; height: 30rpx; border: 4rpx solid #0872fa; border-left: 2rpx solid #0872fa; border-radius: 0 4rpx 4rpx 0; transform: skewY(-12deg); }
.icon-note::before { left: 22rpx; top: 17rpx; width: 29rpx; height: 36rpx; border: 4rpx solid #0872fa; border-radius: 5rpx; }
.icon-note::after { left: 30rpx; top: 27rpx; width: 15rpx; height: 4rpx; background: #0872fa; box-shadow: 0 10rpx 0 #0872fa; }
.icon-note i::before { right: 13rpx; bottom: 12rpx; width: 18rpx; height: 18rpx; border: 4rpx solid #0872fa; border-radius: 50%; background: #fff; }
.icon-review::before { left: 19rpx; top: 17rpx; width: 32rpx; height: 33rpx; border: 4rpx solid #0872fa; border-radius: 6rpx; }
.icon-review::after { left: 28rpx; top: 27rpx; width: 15rpx; height: 4rpx; background: #0872fa; box-shadow: 0 9rpx 0 #0872fa; }
.icon-review i::before { right: 12rpx; bottom: 10rpx; width: 18rpx; height: 18rpx; border: 4rpx solid #0872fa; border-radius: 50%; background: #fff; }
.icon-review i::after { right: 8rpx; bottom: 7rpx; width: 10rpx; height: 4rpx; background: #0872fa; transform: rotate(45deg); border-radius: 5rpx; }
.icon-calendar::before { left: 18rpx; top: 20rpx; width: 38rpx; height: 34rpx; border: 4rpx solid #0872fa; border-radius: 5rpx; }
.icon-calendar::after { left: 18rpx; top: 28rpx; width: 38rpx; height: 4rpx; background: #0872fa; }
.icon-calendar i::before { left: 27rpx; top: 14rpx; width: 4rpx; height: 13rpx; background: #0872fa; box-shadow: 17rpx 0 0 #0872fa; border-radius: 5rpx; }
.invite-card { padding: 36rpx 30rpx 30rpx; border: 2rpx solid #e4e9f2; border-radius: 22rpx; box-shadow: 0 8rpx 24rpx rgba(25,74,145,.025); }
.card-title,.card-subtitle { display:block; text-align:center; }
.card-title { font-size: 36rpx; font-weight: 700; }
.card-subtitle { margin-top: 8rpx; color:#8a93a6; font-size: 23rpx; }
.field { margin-top: 30rpx; }
.field-label { display:block; margin-bottom: 12rpx; font-size: 24rpx; font-weight:650; }
.invite-input { height: 76rpx; padding: 0 22rpx; border: 2rpx solid #dfe4ed; border-radius: 10rpx; background:#fff; font-size:26rpx; letter-spacing:2rpx; }
.placeholder { color:#c3c8d1; letter-spacing:0; }
.field-tip { display:block; margin-top:12rpx; color:#9098aa; font-size:21rpx; }
.consent-row { display:flex; align-items:center; justify-content:center; margin:34rpx 0 22rpx; min-height:38rpx; font-size:22rpx; }
.checkbox { width:30rpx; height:30rpx; margin-right:12rpx; border:2rpx solid #bdc5d2; border-radius:6rpx; color:#fff; text-align:center; line-height:28rpx; font-size:22rpx; }
.checkbox.checked { border-color:#0b72f6; background:#0b72f6; }
.consent-copy { color:#747f96; }.link { color:#0672f9; margin:0 7rpx; }
.error-message { display:block; margin:-8rpx 4rpx 14rpx; color:#e54d58; font-size:22rpx; line-height:1.5; text-align:center; }
button { margin:0; padding:0; line-height:1; border-radius:0; } button::after { border:0; }
.wechat-button { height:96rpx; display:flex; align-items:center; justify-content:center; gap:14rpx; border-radius:18rpx; background:#e7efff; color:#9bb8e9; font-size:29rpx; font-weight:650; }
.wechat-button.enabled { background:linear-gradient(90deg,#1679ff,#0565ef); color:#fff; box-shadow:0 14rpx 28rpx rgba(10,106,242,.18); }
.wechat-mark { position:relative; font-size:17rpx; letter-spacing:-4rpx; }

